     /// the manifest is not a graph node.
+    #[cfg(test)]
     pub(crate) fn reverse_walk(&self, manifest: &str) -> Option<PathDependencyWalk> {
         self.walk(&self.reverse, manifest)
     }
@@ -306,6 +351,7 @@ impl PathDependencyAdjacency {
