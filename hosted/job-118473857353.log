2026-10-20T05:44:26.1921271Z             for line in wheel_metadata.splitlines()
2026-10-20T05:44:26.1921448Z             if line.startswith("Tag: ")
2026-10-20T05:44:26.1921595Z         ]
2026-10-20T05:44:26.1921777Z         assert tags == ["py3-none-linux_x86_64"], f"unexpected wheel tags: {tags}"
2026-10-20T05:44:26.1922021Z         assert not any(tag.endswith("-any") for tag in tags)
2026-10-20T05:44:26.1922190Z 
2026-10-20T05:44:26.1922376Z         license_mit = [name for name in names if PurePosixPath(name).name == "LICENSE-MIT"]
2026-10-20T05:44:26.1922666Z         license_apache = [
2026-10-20T05:44:26.1923085Z             name for name in names if PurePosixPath(name).name == "LICENSE-APACHE"
2026-10-20T05:44:26.1923289Z         ]
2026-10-20T05:44:26.1923439Z         assert len(license_mit) == len(license_apache) == 1
2026-10-20T05:44:26.1923753Z         assert archive.read(license_mit[0]) == Path("LICENSE-MIT").read_bytes()
2026-10-20T05:44:26.1924040Z         assert archive.read(license_apache[0]) == Path("LICENSE-APACHE").read_bytes()
2026-10-20T05:44:26.1924249Z 
2026-10-20T05:44:26.1924442Z         record_rows = list(csv.reader(io.StringIO(archive.read(record_path).decode("utf-8"))))
2026-10-20T05:44:26.1924707Z         record = {row[0]: row[1:] for row in record_rows}
2026-10-20T05:44:26.1924956Z         assert set(names) == set(record), "RECORD inventory does not equal archive inventory"
2026-10-20T05:44:26.1925186Z         for name in names:
2026-10-20T05:44:26.1925332Z             digest, size = record[name]
2026-10-20T05:44:26.1925491Z             if name == record_path:
2026-10-20T05:44:26.1925649Z                 assert digest == size == ""
2026-10-20T05:44:26.1925802Z                 continue
2026-10-20T05:44:26.1925948Z             payload = archive.read(name)
2026-10-20T05:44:26.1926107Z             expected_digest = (
2026-10-20T05:44:26.1926303Z                 base64.urlsafe_b64encode(hashlib.sha256(payload).digest())
2026-10-20T05:44:26.1926501Z                 .rstrip(b"=")
2026-10-20T05:44:26.1926645Z                 .decode("ascii")
2026-10-20T05:44:26.1926783Z             )
2026-10-20T05:44:26.1926989Z             assert digest == f"sha256={expected_digest}", f"RECORD digest mismatch for {name}"
2026-10-20T05:44:26.1927276Z             assert size == str(len(payload)), f"RECORD size mismatch for {name}"
2026-10-20T05:44:26.1927471Z 
