2026-10-20T05:44:26.1918355Z         assert len(metadata_paths) == len(wheel_paths) == len(record_paths) == 1
2026-10-20T05:44:26.1918579Z         metadata_path = metadata_paths[0]
2026-10-20T05:44:26.1918744Z         wheel_path = wheel_paths[0]
2026-10-20T05:44:26.1918905Z         record_path = record_paths[0]
2026-10-20T05:44:26.1919050Z 
2026-10-20T05:44:26.1919225Z         metadata = Parser().parsestr(archive.read(metadata_path).decode("utf-8"))
2026-10-20T05:44:26.1919458Z         assert metadata["Name"] == "ripr-rs"
2026-10-20T05:44:26.1919654Z         assert metadata["Version"] == expected_python_version
2026-10-20T05:44:26.1919862Z         assert metadata["Requires-Python"] == ">=3.10"
2026-10-20T05:44:26.1920083Z         assert metadata["License-Expression"] == "MIT OR Apache-2.0"
2026-10-20T05:44:26.1920378Z         assert not metadata.get_all("Requires-Dist"), "native wheel acquired runtime dependencies"
2026-10-20T05:44:26.1920614Z 
2026-10-20T05:44:26.1920763Z         wheel_metadata = archive.read(wheel_path).decode("utf-8")
2026-10-20T05:44:26.1920951Z         tags = [
