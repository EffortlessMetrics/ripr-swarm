2026-10-20T06:04:24.1834638Z     echo "analysis-result=not_proven"
2026-10-20T06:04:24.1839164Z     echo "publication-result=not_proven"
2026-10-20T06:04:24.1839663Z     echo "gate-result=not_proven"
2026-10-20T06:04:24.1840207Z     echo 'not-proven-reasons=["gate-outcome: review/gate_outcome.json is missing"]'
2026-10-20T06:04:24.1842838Z     echo "sensor-coverage={}"
2026-10-20T06:04:24.1845974Z   } >> "$GITHUB_OUTPUT"
2026-10-20T06:04:24.1848307Z   exit 0
2026-10-20T06:04:24.1848660Z fi
2026-10-20T06:04:24.1849088Z # A null/absent field or a jq failure both yield the fail-closed
2026-10-20T06:04:24.1852076Z # fallback, so a future-incompatible artifact never implies a pass.
2026-10-20T06:04:24.1854472Z read_field() {
2026-10-20T06:04:24.1856523Z   jq -r --arg field "$1" --arg fallback "$2" \
2026-10-20T06:04:24.1857049Z     '(.[$field] // $fallback) | tostring' \
2026-10-20T06:04:24.1859754Z     "$UB_REVIEW_GATE_OUTCOME_PATH" 2>/dev/null || printf '%s' "$2"
2026-10-20T06:04:24.1861962Z }
2026-10-20T06:04:24.1864073Z conclusion="$(read_field conclusion missing)"
2026-10-20T06:04:24.1866402Z analysis="$(read_field analysis_result not_proven)"
2026-10-20T06:04:24.1866992Z publication="$(read_field publication_result not_proven)"
2026-10-20T06:04:24.1869187Z gate="$(read_field gate_result not_proven)"
2026-10-20T06:04:24.1871962Z reasons="$(jq -c '.not_proven_reasons // []' "$UB_REVIEW_GATE_OUTCOME_PATH" 2>/dev/null || printf '[]')"
2026-10-20T06:04:24.1874511Z coverage="$(jq -c '.sensor_coverage // {}' "$UB_REVIEW_GATE_OUTCOME_PATH" 2>/dev/null || printf '{}')"
2026-10-20T06:04:24.1876838Z {
2026-10-20T06:04:24.1877225Z   echo "gate-conclusion=$conclusion"
2026-10-20T06:04:24.1879197Z   echo "analysis-result=$analysis"
2026-10-20T06:04:24.1881218Z   echo "publication-result=$publication"
2026-10-20T06:04:24.1883486Z   echo "gate-result=$gate"
2026-10-20T06:04:24.1885490Z   echo "not-proven-reasons=$reasons"
2026-10-20T06:04:24.1885983Z   echo "sensor-coverage=$coverage"
2026-10-20T06:04:24.1887923Z } >> "$GITHUB_OUTPUT"
