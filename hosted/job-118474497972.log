2026-10-20T05:40:39.1399330Z normalize_release_version() {
2026-10-20T05:40:39.1399599Z   case "$1" in
2026-10-20T05:40:39.1399820Z     refs/tags/*)
2026-10-20T05:40:39.1400076Z       printf '%s\n' "${1#refs/tags/}"
2026-10-20T05:40:39.1400356Z       ;;
2026-10-20T05:40:39.1400552Z     *)
2026-10-20T05:40:39.1400755Z       printf '%s\n' "$1"
2026-10-20T05:40:39.1401006Z       ;;
2026-10-20T05:40:39.1401195Z   esac
2026-10-20T05:40:39.1401643Z }
