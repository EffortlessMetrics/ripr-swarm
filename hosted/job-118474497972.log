2026-10-20T05:40:39.1415010Z     return 1
2026-10-20T05:40:39.1415344Z   fi
2026-10-20T05:40:39.1415618Z   if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
2026-10-20T05:40:39.1416199Z     report_release_unavailable notice "release binary unavailable; only Linux x64 runners are supported"
2026-10-20T05:40:39.1416705Z     return 1
2026-10-20T05:40:39.1416906Z   fi
2026-10-20T05:40:39.1417091Z 
2026-10-20T05:40:39.1417374Z   release_dir="${RUNNER_TEMP:-/tmp}/ub-review-action-release"
2026-10-20T05:40:39.1417762Z   archive="$release_dir/$release_asset"
2026-10-20T05:40:39.1418212Z   url="${server_url%/}/$action_repo/releases/download/$release_version/$release_asset"
2026-10-20T05:40:39.1418703Z   checksum="$release_dir/$release_asset.sha256"
