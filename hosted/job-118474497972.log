2026-10-20T05:40:39.1384094Z build_from_source() {
2026-10-20T05:40:39.1384454Z   # Source mode remains the deterministic fallback. Callers can cache
2026-10-20T05:40:39.1384930Z   # the target dir (via CARGO_TARGET_DIR + a cache step) for faster
2026-10-20T05:40:39.1385414Z   # follow-up runs — without it every run recompiles ~12 min of deps.
2026-10-20T05:40:39.1385884Z   workdir="${RUNNER_TEMP:-/tmp}/ub-review-action-src"
2026-10-20T05:40:39.1386226Z   rm -rf "$workdir"
2026-10-20T05:40:39.1386630Z   mkdir -p "$workdir"
2026-10-20T05:40:39.1386920Z   cp -R "$GITHUB_ACTION_PATH/." "$workdir/"
2026-10-20T05:40:39.1387207Z 
2026-10-20T05:40:39.1387501Z   # Resolve the target dir BEFORE the build so --target-dir is passed
2026-10-20T05:40:39.1387995Z   # to cargo (otherwise cargo builds in $workdir/target, ignoring the
2026-10-20T05:40:39.1388476Z   # cache). When CARGO_TARGET_DIR is set, it must be an absolute path
2026-10-20T05:40:39.1388951Z   # so the cache step (which keys on absolute paths) can restore it.
2026-10-20T05:40:39.1389348Z   if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
2026-10-20T05:40:39.1389651Z     case "$CARGO_TARGET_DIR" in
2026-10-20T05:40:39.1389918Z       /*)
2026-10-20T05:40:39.1390162Z         cargo_target_dir="$CARGO_TARGET_DIR"
2026-10-20T05:40:39.1390452Z         ;;
2026-10-20T05:40:39.1390651Z       *)
2026-10-20T05:40:39.1390909Z         cargo_target_dir="$PWD/$CARGO_TARGET_DIR"
2026-10-20T05:40:39.1391211Z         ;;
2026-10-20T05:40:39.1391868Z     esac
2026-10-20T05:40:39.1392080Z   else
2026-10-20T05:40:39.1392308Z     cargo_target_dir="$workdir/target"
2026-10-20T05:40:39.1392604Z   fi
2026-10-20T05:40:39.1392819Z   mkdir -p "$cargo_target_dir"
2026-10-20T05:40:39.1393084Z 
2026-10-20T05:40:39.1393295Z   lockfile="$workdir/Cargo.lock"
2026-10-20T05:40:39.1393625Z   if [[ -L "$lockfile" || ! -f "$lockfile" ]]; then
2026-10-20T05:40:39.1394108Z     echo "::error::source install requires a committed regular Cargo.lock at $lockfile"
2026-10-20T05:40:39.1394548Z     exit 1
2026-10-20T05:40:39.1394750Z   fi
2026-10-20T05:40:39.1394935Z 
2026-10-20T05:40:39.1395199Z   echo "::group::Build ub-review from action source"
2026-10-20T05:40:39.1395761Z   cargo build --manifest-path "$workdir/Cargo.toml" --locked --release --target-dir "$cargo_target_dir"
2026-10-20T05:40:39.1396274Z   echo "::endgroup::"
2026-10-20T05:40:39.1396506Z 
2026-10-20T05:40:39.1396734Z   bin="$cargo_target_dir/release/ub-review"
2026-10-20T05:40:39.1397191Z   if [[ ! -x "$bin" ]]; then
2026-10-20T05:40:39.1397529Z     echo "::error::ub-review binary was not produced at $bin"
2026-10-20T05:40:39.1397882Z     exit 1
2026-10-20T05:40:39.1398090Z   fi
2026-10-20T05:40:39.1398340Z   echo "source-dir=$workdir" >> "$GITHUB_OUTPUT"
2026-10-20T05:40:39.1398675Z   echo "bin=$bin" >> "$GITHUB_OUTPUT"
2026-10-20T05:40:39.1398948Z }
