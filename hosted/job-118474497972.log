2026-10-20T05:40:39.1402019Z validate_release_request() {
2026-10-20T05:40:39.1402333Z   if [[ "$release_version" =~ [^A-Za-z0-9._-] ]]; then
2026-10-20T05:40:39.1402893Z     echo "::error::release-version must be a simple tag name using letters, numbers, dot, underscore, or dash"
2026-10-20T05:40:39.1403406Z     exit 1
2026-10-20T05:40:39.1403616Z   fi
2026-10-20T05:40:39.1404031Z   if [[ -z "$release_asset" || "$release_asset" == */* || "$release_asset" == *\\* || "$release_asset" == *..* ]]; then
2026-10-20T05:40:39.1404615Z     echo "::error::release-asset must be a file name, not a path"
2026-10-20T05:40:39.1405103Z     exit 1
2026-10-20T05:40:39.1405316Z   fi
2026-10-20T05:40:39.1405559Z   if [[ "$release_asset" =~ [^A-Za-z0-9._-] ]]; then
2026-10-20T05:40:39.1406040Z     echo "::error::release-asset must use only letters, numbers, dot, underscore, or dash"
2026-10-20T05:40:39.1406485Z     exit 1
2026-10-20T05:40:39.1406684Z   fi
2026-10-20T05:40:39.1406876Z }
