+        observe_module_read(&broken.0, &broken.0.join("missing.rs"), false);
+        assert!(
+            boundary.verify().is_err(),
+            "failed observation must refuse its run"
+        );
+        let concurrent_result = concurrent.verify();
+        drop(boundary);
+        drop(concurrent);
+        let fresh = Boundary::new(&stable.0)?;
+        fresh.verify()?;
+        concurrent_result?;
+        Ok(())
+    }
