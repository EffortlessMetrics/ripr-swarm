+        let boundary = Boundary::new(&alias)?;
+        observe_module_read(&alias, &alias.join("lib.rs"), false);
+        observe_module_read(&alias, &alias.join("absent/module.rs"), false);
+        boundary.verify()?;
+        observe_module_read(&alias, &alias.join(".git/absent.rs"), false);
