{
  "name": "ripr",
  "displayName": "ripr: Static Mutation Exposure",
  "description": "Static check for Rust changes in your editor: see which changed behavior your tests would not notice, with a focused test brief and agent handoff commands.",
  "version": "0.11.0",
  "publisher": "EffortlessMetrics",
  "preview": true,
  "license": "MIT OR Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EffortlessMetrics/ripr.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/EffortlessMetrics/ripr/issues"
  },
  "homepage": "https://github.com/EffortlessMetrics/ripr",
  "categories": [
    "Linters",
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "rust",
    "testing",
    "mutation-testing",
    "ripr",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "workspaceContains:Cargo.toml",
    "onCommand:ripr.restartServer",
    "onCommand:ripr.refreshDiagnostics",
    "onCommand:ripr.showStatus",
    "onCommand:ripr.showAttemptStatus",
    "onCommand:ripr.showOutput",
    "onCommand:ripr.diagnoseSetup",
    "onCommand:ripr.startCurrentRepair",
    "onCommand:ripr.startOrContinueRepair",
    "onCommand:ripr.copyCurrentRepairPacket",
    "onCommand:ripr.copyRepoGapMap",
    "onCommand:ripr.openFirstPrPacket",
    "onCommand:ripr.copyFirstPrSummary",
    "onCommand:ripr.copyFirstPrRepairPacket",
    "onCommand:ripr.copyRepairPacketAtCursor",
    "onCommand:ripr.copyFirstPrVerifyCommand",
    "onCommand:ripr.copyFirstPrReceiptCommand",
    "onCommand:ripr.copyFirstPrRegenerationGuidance",
    "onCommand:ripr.copyTopRepairPacket",
    "onCommand:ripr.copyTopVerifyCommand",
    "onCommand:ripr.copyTopReceiptCommand",
    "onCommand:ripr.openReport",
    "onCommand:ripr.showTopLimitation",
    "onCommand:ripr.showReceiptStatus",
    "onCommand:ripr.copyReceiptCommand",
    "onCommand:ripr.openAttemptLedger",
    "onCommand:ripr.showRouteQuality"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "cargo xtask vscode-compile",
    "package": "cargo xtask vscode-package",
    "test": "cargo xtask vscode-test",
    "test:e2e": "cargo xtask vscode-test-e2e"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^10.8.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": {
      "minimatch": {
        "brace-expansion": "^5.0.6"
      }
    },
    "mocha": {
      "serialize-javascript": "^7.0.5"
    },
    "vscode-languageclient": {
      "minimatch": "^11.0.3"
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Server download, launch, analysis, and repair require a trusted workspace.",
      "restrictedConfigurations": [
        "ripr.server.path",
        "ripr.server.args",
        "ripr.server.autoDownload",
        "ripr.server.version",
        "ripr.server.downloadBaseUrl"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "ripr",
      "properties": {
        "ripr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable saved-workspace ripr diagnostics, hovers, status, and code actions."
        },
        "ripr.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a ripr executable. Overrides bundled, downloaded, and PATH server resolution.",
          "scope": "resource"
        },
        "ripr.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp",
            "--stdio"
          ],
          "description": "Arguments used to start the ripr language server.",
          "scope": "resource"
        },
        "ripr.server.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically download the matching ripr server binary when no configured, bundled, cached, or (while ripr.server.version is empty) compatible PATH server is available. Downloads over HTTPS — by default from github.com/EffortlessMetrics/ripr releases, configurable via ripr.server.downloadBaseUrl — and archives are SHA-256 verified against the release manifest before extraction.",
          "scope": "resource"
        },
        "ripr.server.version": {
          "type": "string",
          "default": "",
          "description": "Pinned ripr server version. Empty means match the extension version.",
          "scope": "resource"
        },
        "ripr.server.downloadBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Override the server manifest base URL for internal mirrors. Empty uses GitHub Releases.",
          "scope": "resource"
        },
        "ripr.check.mode": {
          "type": "string",
          "enum": [
            "instant",
            "draft",
            "fast",
            "deep",
            "ready"
          ],
          "enumDescriptions": [
            "Instant: fastest, scopes to changed file only",
            "Draft: default developer mode, scopes to changed package",
            "Fast: currently equivalent to draft",
            "Deep: scopes to the entire workspace",
            "Ready: review-ready mode, deep scope with stricter evidence"
          ],
          "default": "draft",
          "description": "Preferred ripr check mode for editor-triggered analysis."
        },
        "ripr.baseRef": {
          "type": "string",
          "default": "",
          "description": "Git base ref used by ripr editor diagnostics and context commands. Empty uses the repository's default branch, resolved like `ripr check`: origin/HEAD, then origin/main, origin/master, main, master. If none resolves, set this to the branch to compare against."
        },
        "ripr.includeUnchangedTests": {
          "type": "boolean",
          "default": true,
          "description": "Also look at tests you have not changed when checking whether your changes are covered.",
          "scope": "resource"
        },
        "ripr.seamDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Also report gaps found elsewhere in the saved workspace, not only in the code you changed.",
          "scope": "resource"
        },
        "ripr.diagnosticProfile": {
          "type": "string",
          "enum": [
            "actionable",
            "full"
          ],
          "enumDescriptions": [
            "Actionable: show only findings that come with a specific suggested next step",
            "Full: show every finding, including extra detail for troubleshooting"
          ],
          "default": "actionable",
          "description": "How much ripr shows in the Problems panel. 'actionable' shows only findings with a specific suggested next step; 'full' shows everything, including extra detail for troubleshooting.",
          "scope": "resource"
        },
        "ripr.gitTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000,
          "description": "Longest time, in milliseconds, ripr waits for each git command while refreshing. A slower git command is stopped and ripr shows a limited result that says git timed out; run ripr: Refresh Diagnostics to try again."
        },
        "ripr.refreshDeadlineMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 600000,
          "description": "Longest time, in milliseconds, one analysis refresh may run before ripr stops it. A stopped refresh shows no new results and reports 'analysis deadline exceeded'; save a file or run ripr: Refresh Diagnostics to start a fresh attempt."
        },
        "ripr.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Off: no trace output",
            "Messages: log request/response method names and byte counts",
            "Verbose: log full messages (not how findings were reached)"
          ],
          "default": "off",
          "description": "Log the messages passed between VS Code and the ripr server in the ripr output channel. This does not show how ripr reached its findings; use `ripr explain` or `ripr check --json` for that."
        }
      }
    },
    "commands": [
      {
        "command": "ripr.restartServer",
        "title": "ripr: Restart Server"
      },
      {
        "command": "ripr.refreshDiagnostics",
        "title": "ripr: Refresh Full Analysis"
      },
      {
        "command": "ripr.selectWorkspaceRoot",
        "title": "ripr: Select Workspace Root"
      },
      {
        "command": "ripr.showOutput",
        "title": "ripr: Show Output"
      },
      {
        "command": "ripr.showStatus",
        "title": "ripr: Show Status"
      },
      {
        "command": "ripr.showAttemptStatus",
        "title": "ripr: Show Repair Attempt Status"
      },
      {
        "command": "ripr.diagnoseSetup",
        "title": "ripr: Diagnose Setup"
      },
      {
        "command": "ripr.startCurrentRepair",
        "title": "ripr: Start Current Repair"
      },
      {
        "command": "ripr.startOrContinueRepair",
        "title": "ripr: Start or Continue Repair"
      },
      {
        "command": "ripr.copyCurrentRepairPacket",
        "title": "ripr: Copy Current Repair Packet"
      },
      {
        "command": "ripr.copyRepoGapMap",
        "title": "ripr: Copy Repo Gap Map"
      },
      {
        "command": "ripr.openFirstPrPacket",
        "title": "ripr: First PR - Open Packet"
      },
      {
        "command": "ripr.copyFirstPrSummary",
        "title": "ripr: First PR - Copy Summary"
      },
      {
        "command": "ripr.copyFirstPrRepairPacket",
        "title": "ripr: First PR - Copy Repair Packet"
      },
      {
        "command": "ripr.copyRepairPacketAtCursor",
        "title": "ripr: Copy Repair Packet at Cursor"
      },
      {
        "command": "ripr.copyFirstPrVerifyCommand",
        "title": "ripr: First PR - Copy Verify Command"
      },
      {
        "command": "ripr.copyFirstPrReceiptCommand",
        "title": "ripr: First PR - Copy Result Record Command"
      },
      {
        "command": "ripr.copyFirstPrRegenerationGuidance",
        "title": "ripr: First PR - Copy Steps to Regenerate Packet"
      },
      {
        "command": "ripr.copyContext",
        "title": "ripr: Inspect Test Gap - Copy Context"
      },
      {
        "command": "ripr.copySuggestedAssertion",
        "title": "ripr: Write Targeted Test - Copy Suggested Assertion"
      },
      {
        "command": "ripr.copyTargetedTestBrief",
        "title": "ripr: Write Targeted Test - Copy Brief"
      },
      {
        "command": "ripr.copyAgentRepairCommand",
        "title": "ripr: Start Repair - Copy Repair Command"
      },
      {
        "command": "ripr.copyAgentPacketCommand",
        "title": "ripr: Agent Handoff - Copy Packet Command"
      },
      {
        "command": "ripr.copyAgentBriefCommand",
        "title": "ripr: Agent Handoff - Copy Brief Command"
      },
      {
        "command": "ripr.copyAfterSnapshotCommand",
        "title": "ripr: Verify After Test - Copy After Snapshot Command"
      },
      {
        "command": "ripr.copyAgentVerifyCommand",
        "title": "ripr: Verify After Test - Copy Verify Command"
      },
      {
        "command": "ripr.copyAgentReceiptCommand",
        "title": "ripr: Review Result - Copy Result Record Command"
      },
      {
        "command": "ripr.openRelatedTest",
        "title": "ripr: Write Targeted Test - Open Best Related Test"
      },
      {
        "command": "ripr.openSettings",
        "title": "ripr: Open Settings"
      },
      {
        "command": "ripr.copyTopRepairPacket",
        "title": "ripr: Copy Top Repair Packet"
      },
      {
        "command": "ripr.copyTopVerifyCommand",
        "title": "ripr: Copy Verify Command (Top Repair Packet)"
      },
      {
        "command": "ripr.copyTopReceiptCommand",
        "title": "ripr: Copy Result Record Command (Top Repair Packet)"
      },
      {
        "command": "ripr.openReport",
        "title": "ripr: Open Report"
      },
      {
        "command": "ripr.showTopLimitation",
        "title": "ripr: Show Main Analysis Limit"
      },
      {
        "command": "ripr.showReceiptStatus",
        "title": "ripr: Show Result Record Status"
      },
      {
        "command": "ripr.copyReceiptCommand",
        "title": "ripr: Copy Result Record Command (Result Record Status)"
      },
      {
        "command": "ripr.openAttemptLedger",
        "title": "ripr: Open Repair Attempt History"
      },
      {
        "command": "ripr.showRouteQuality",
        "title": "ripr: Show Repair Route Summary"
      }
    ],
    "submenus": [
      {
        "id": "ripr.editorContext",
        "label": "ripr"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ripr.copyRepairPacketAtCursor",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@1"
        },
        {
          "submenu": "ripr.editorContext",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@2"
        }
      ],
      "ripr.editorContext": [
        {
          "command": "ripr.copyTopRepairPacket",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@1"
        },
        {
          "command": "ripr.copyTopVerifyCommand",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@2"
        },
        {
          "command": "ripr.copyTopReceiptCommand",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@3"
        },
        {
          "command": "ripr.showTopLimitation",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@4"
        },
        {
          "command": "ripr.showStatus",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@5"
        },
        {
          "command": "ripr.showReceiptStatus",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@6"
        },
        {
          "command": "ripr.showRouteQuality",
          "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/",
          "group": "ripr@7"
        }
      ],
      "commandPalette": [
        {
          "command": "ripr.copySuggestedAssertion",
          "when": "false"
        },
        {
          "command": "ripr.copyTargetedTestBrief",
          "when": "false"
        },
        {
          "command": "ripr.openRelatedTest",
          "when": "false"
        },
        {
          "command": "ripr.copyAgentRepairCommand",
          "when": "false"
        },
        {
          "command": "ripr.copyAgentPacketCommand",
          "when": "false"
        },
        {
          "command": "ripr.copyAgentBriefCommand",
          "when": "false"
        },
        {
          "command": "ripr.copyAfterSnapshotCommand",
          "when": "false"
        },
        {
          "command": "ripr.copyAgentVerifyCommand",
          "when": "false"
        },
        {
          "command": "ripr.copyAgentReceiptCommand",
          "when": "false"
        },
        {
          "command": "ripr.startCurrentRepair",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ripr.copyRepairPacketAtCursor",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && resourceLangId =~ /^(rust|typescript|typescriptreact|javascript|javascriptreact|python)$/"
      },
      {
        "command": "ripr.showStatus",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "ripr.copyTopRepairPacket",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      }
    ],
    "walkthroughs": [
      {
        "id": "ripr.getStarted",
        "title": "ripr: Get Started",
        "description": "First-run guide for ripr's static mutation-exposure diagnostics: trust, open, diagnose, act.",
        "steps": [
          {
            "id": "ripr.trustWorkspace",
            "title": "Trust this workspace",
            "description": "ripr starts its server only in trusted workspaces.\n[Why trust matters](walkthrough/trust.md)",
            "media": {
              "markdown": "walkthrough/trust.md"
            },
            "completionEvents": [
              "onContext:isWorkspaceTrusted"
            ]
          },
          {
            "id": "ripr.openRustFile",
            "title": "Open a Rust file",
            "description": "ripr analyzes the saved workspace in the background.\n[What happens on open](walkthrough/open-file.md)",
            "media": {
              "markdown": "walkthrough/open-file.md"
            },
            "completionEvents": [
              "onContext:resourceLangId == rust"
            ]
          },
          {
            "id": "ripr.readDiagnostics",
            "title": "Read ripr diagnostics",
            "description": "Problems panel entries carry the `ripr` source label.\n[Reading ripr evidence](walkthrough/diagnostics.md)",
            "media": {
              "markdown": "walkthrough/diagnostics.md"
            }
          },
          {
            "id": "ripr.tryCodeAction",
            "title": "Try a ripr code action",
            "description": "Copy the missing test assertion (the check that would catch a wrong behavior) or the repair packet from the lightbulb.\n[ripr actions](walkthrough/code-action.md)",
            "media": {
              "markdown": "walkthrough/code-action.md"
            },
            "completionEvents": [
              "onCommand:ripr.showStatus"
            ]
          }
        ]
      }
    ]
  }
}
