# No server/** entry: no bundled server directory ships today, so the
# current VSIX contains no server binary. The resolver's bundled path
# (server/<target>/) is dormant (#2085); if future platform VSIXs ship
# one (#1443 / #1624), that tree must stay packaged, not ignored.
src/**
test/**
test-fixtures/**
tsconfig.json
tsconfig.setup.json
*.vsix
dist/**
out/test/**
out/**/*.map
out/test/**
out/src/test/**
# Cargo output under the extension (for example a cwd-relative `cargo xtask`
# target dir, ripr#1690) must never be packaged into the VSIX.
target/**
