        "raw_block_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cover_properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "description",
              "location"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "SATISFIED",
                  "UNSATISFIABLE",
                  "UNREACHABLE",
                  "UNDETERMINED",
                  "ERROR"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "native_verdict": {
          "enum": [
            "verified",
            "counterexample",
            "unreachable_cover",
            "timeout",
            "missing",
            "ambiguous",
            "abnormal_process",
            "malformed",
            "unsupported",
            "unknown"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "description",
              "location"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "SUCCESS",
                  "FAILURE",
                  "SATISFIED",
                  "UNSATISFIABLE",
                  "UNREACHABLE",
                  "UNDETERMINED",
                  "ERROR"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "enum": [
                    "ESTABLISHED",
                    "FAILED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "then": {
        "properties": {
          "process": {
            "properties": {
              "raw_output_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "name": {
                "const": "kani"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "family": {
                "const": "bounded_model_check"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "process": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            },
            "required": [
              "state"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "status": {
                  "const": "NOT_ESTABLISHED"
                },
                "native_verdict": {
                  "const": "missing"
                },
                "raw_block_digest": {
                  "type": "null"
                },
                "duration_ms": {
                  "type": "null"
                },
                "peak_memory_bytes": {
                  "type": "null"
                },
                "covers": {
                  "properties": {
                    "satisfied": {
                      "const": 0
                    },
                    "unreachable": {
                      "const": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inventory": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "results": {
                "minItems": 1
              }
            },
            "required": [
              "results"
            ]
          },
          {
            "properties": {
              "unregistered_results": {
                "minItems": 1
              }
            },
            "required": [
              "unregistered_results",
              "execution"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "enum": [
                    "ESTABLISHED",
                    "FAILED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "then": {
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
          },
          "tree": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
          },
          "source_closure_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          }
        }
      }
    }
  ]
