{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/ripr/design/native-proof-run-v1.schema.json",
  "title": "RIPR native proof run v1 design contract",
  "description": "Design contract only until the Kani runner emits and validates this DTO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "repository",
    "revision",
    "tree",
    "source_closure_digest",
    "claim_registry_generation",
    "provider",
    "toolchain",
    "runner",
    "inventory",
    "process",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "ripr.native-proof-run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tree": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "worktree_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_closure_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_registry_generation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "name",
        "version"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "solver_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "command_digest",
        "deadline_policy"
      ],
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "command_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "deadline_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preflight_seconds",
            "whole_run_seconds",
            "per_subject_seconds"
          ],
          "properties": {
            "preflight_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "whole_run_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "per_subject_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_claim_ids",
        "discovered_subjects",
        "complete"
      ],
      "properties": {
        "expected_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "discovered_subjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "rejection_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "discovered_subjects": {
                "minItems": 1
              },
              "rejection_reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "required": [
              "rejection_reasons"
            ],
            "properties": {
              "rejection_reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "timed_out",
        "raw_output_digest",
        "cleanup_state"
      ],
      "properties": {
        "state": {
          "enum": [
            "completed",
            "failed",
            "timed_out",
            "killed",
            "not_started"
          ],
          "$comment": "ripr-allow: static-language: OS process termination, not a mutation outcome."
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "raw_output_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup_state": {
          "enum": [
            "complete",
            "residue",
            "failed",
            "not_applicable",
            "not_observed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "timed_out": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "timed_out"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "timed_out": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "timed_out": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "killed"
                ],
                "$comment": "ripr-allow: static-language: OS process termination, not a mutation outcome."
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "raw_output_digest": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      },
      "uniqueItems": true
    },
    "unregistered_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unregistered_result"
      }
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/native_execution"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_generation",
        "subject",
        "source_digest",
        "status",
        "native_verdict",
        "covers",
        "bounds_digest",
        "duration_ms",
        "current",
        "reasons",
        "non_claims"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim_generation": {
          "type": "integer",
          "minimum": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "status": {
          "enum": [
            "ESTABLISHED",
            "FAILED",
            "NOT_ESTABLISHED",
            "STALE",
            "UNSUPPORTED",
            "NOT_PROVEN"
          ]
        },
        "native_verdict": {
          "enum": [
            "verified",
            "counterexample",
            "unreachable_cover",
            "timeout",
            "missing",
            "ambiguous",
            "abnormal_process",
            "malformed",
            "unsupported",
            "unknown"
          ]
        },
        "covers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "satisfied",
            "unreachable"
          ],
          "properties": {
            "required": {
              "type": "integer",
              "minimum": 0
            },
            "satisfied": {
              "type": "integer",
              "minimum": 0
            },
            "unreachable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "assumptions_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "raw_block_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "current": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ESTABLISHED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "raw_block_digest",
              "assumptions_digest"
            ],
            "properties": {
              "native_verdict": {
                "const": "verified"
              },
              "current": {
                "const": true
              },
              "assumptions_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              },
              "raw_block_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "covers": {
                "properties": {
                  "unreachable": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "raw_block_digest",
              "assumptions_digest"
            ],
            "properties": {
              "native_verdict": {
                "enum": [
                  "counterexample",
                  "unreachable_cover"
                ]
              },
              "current": {
                "const": true
              },
              "assumptions_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              },
              "raw_block_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "ESTABLISHED"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              },
              "native_verdict": {
                "const": "unreachable_cover"
              }
            },
            "required": [
              "status",
              "native_verdict"
            ]
          },
          "then": {
            "properties": {
              "covers": {
                "properties": {
                  "required": {
                    "minimum": 1
                  },
                  "unreachable": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "STALE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "current": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "native_verdict": {
                "const": "timeout"
              }
            },
            "required": [
              "native_verdict"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "NOT_ESTABLISHED",
                  "STALE"
                ]
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "native_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "file",
        "name",
        "qualified_name",
        "source_digest"
      ],
      "properties": {
        "package": {
          "enum": [
            "ripr",
            "ripr-contract"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "qualified_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "native_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "artifact_directory",
        "repository_directory",
        "native_inventory_artifacts",
        "source_before",
        "source_after",
        "source_current",
        "configuration_policy",
        "configuration_digest",
        "configuration_admitted",
        "configuration_rejections",
        "declared_subjects",
        "selected_subjects",
        "native_subjects",
        "observed_subjects",
        "invocations",
        "inventory_rejections",
        "rejection_reasons",
        "allow_empty",
        "lane_success",
        "github_run_id",
        "github_run_attempt",
        "github_job",
        "non_claims",
        "selected_packages",
        "harness_filter",
        "configuration_before",
        "configuration_after",
        "cargo_metadata",
        "installed_toolchain",
        "registration",
        "producer_entrypoint",
        "producer_arguments",
        "default_unwind",
        "installed_toolchain_after",
        "explicit_inputs",
        "package_inputs"
      ],
      "properties": {
        "producer": {
          "const": "ripr-kani-custody-v1"
        },
        "artifact_directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repository_directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "native_inventory_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "artifact"
            ],
            "properties": {
              "package": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        },
        "source_before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "tree",
            "dirty",
            "manifest",
            "file_count",
            "error"
          ],
          "properties": {
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tree": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "source_after": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "tree",
            "dirty",
            "manifest",
            "file_count",
            "error"
          ],
          "properties": {
            "revision": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tree": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/artifact"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_count": {
              "type": "integer",
              "minimum": 0
            },
            "error": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "source_current": {
          "type": "boolean"
        },
        "configuration_policy": {
          "const": "kani-0.68-defaults-v1"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "configuration_admitted": {
          "type": "boolean"
        },
        "configuration_rejections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "declared_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_subject"
          }
        },
        "selected_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_subject"
          }
        },
        "native_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/native_subject"
          }
        },
        "observed_subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "invocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "package",
              "program",
              "arguments",
              "timeout_ms",
              "stream_limit_bytes",
              "duration_ms",
              "exit_code",
              "native_status",
              "timed_out",
              "capture_complete",
              "stdout",
              "stderr",
              "error",
              "working_directory"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "package": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "program": {
                "type": "string",
