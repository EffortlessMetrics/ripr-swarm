    "unregistered_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "status",
        "detail",
        "kani_time",
        "covers",
        "raw_block_digest",
        "cover_properties",
        "native_verdict",
        "duration_ms",
        "properties"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/native_subject"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "FAILED",
            "NOT_ESTABLISHED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kani_time": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "covers": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "total",
                "satisfied",
                "undetermined"
              ],
              "properties": {
                "total": {
                  "type": "integer",
                  "minimum": 0
                },
                "satisfied": {
                  "type": "integer",
                  "minimum": 0
                },
                "undetermined": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
