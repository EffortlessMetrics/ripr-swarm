        "package_inputs": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "ripr",
              "ripr-contract"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
