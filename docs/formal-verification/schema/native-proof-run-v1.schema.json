              "stderr": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/artifact"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "working_directory": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inventory_rejections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "rejection_reasons": {
          "type": "array",
          "items": {
