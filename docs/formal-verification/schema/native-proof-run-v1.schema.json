                "type": "integer",
                "minimum": 1
              },
              "duration_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "native_status": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timed_out": {
                "type": "boolean"
              },
              "capture_complete": {
                "type": "boolean"
              },
              "stdout": {
                "anyOf": [
