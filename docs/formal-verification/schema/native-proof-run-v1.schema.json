        "github_job": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "selected_packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ripr",
              "ripr-contract"
            ]
          }
        },
        "harness_filter": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_before": {
          "$ref": "#/$defs/artifact"
        },
        "configuration_after": {
          "$ref": "#/$defs/artifact"
        },
        "cargo_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "installed_toolchain": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer_entrypoint": {
          "enum": [
            "xtask",
