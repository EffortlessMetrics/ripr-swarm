{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/ripr/design/formal-claim-v1.schema.json",
  "title": "RIPR formal claim v1 design contract",
  "description": "Design contract only until the repository validator and runtime registry are implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "claim_generation",
    "family",
    "provider",
    "criticality",
    "phase",
    "proposition",
    "non_claims",
    "owners",
    "source_closure",
    "domain",
    "assumptions",
    "trust_dependencies",
    "observable",
    "bounds",
    "subjects",
    "required_covers",
    "negative_controls",
    "result_satisfaction",
    "currentness_inputs",
    "transition_policy",
    "owner_spec",
    "owner_issue"
  ],
  "properties": {
    "schema": {"const": "ripr.formal-claim.v1"},
    "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "claim_generation": {"type": "integer", "minimum": 1},
    "family": {
      "enum": [
        "bounded_model_check",
        "deductive_proof",
        "state_machine_model",
        "concurrency_model",
        "undefined_behavior_execution",
        "property_test",
        "fuzz_campaign",
        "mutation_calibration",
        "manual_or_external"
      ]
    },
    "provider": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "criticality": {"enum": ["critical", "important", "advisory", "scheduled", "manual"]},
    "phase": {
      "description": "Admitted merge-group qualification is the target development phase. Legacy ordinary_pr_critical and merge_ready values remain inspectable historical declarations, never workflow-trigger authority.",
      "enum": ["admitted_merge_group", "ordinary_pr_critical", "merge_ready", "scheduled", "release", "manual"]
    },
    "proposition": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "non_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "minItems": 1,
      "uniqueItems": true
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "source_closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:\\x00-\\x1f\\x7f-\\x9f])(?=.*\\S)(?!.*\\/$).+$"
      }
    },
    "domain": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "uniqueItems": true},
    "trust_dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "minItems": 1,
      "uniqueItems": true
    },
    "observable": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "bounds": {
      "type": "object",
      "additionalProperties": {"type": ["string", "integer", "number", "boolean"]},
      "minProperties": 1,
      "properties": {"unwind": {"type": "integer", "minimum": 1}}
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "required_covers": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}, "uniqueItems": true},
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "uniqueItems": true
    },
    "result_satisfaction": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "currentness_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "transition_policy": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "owner_spec": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "owner_issue": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"criticality": {"const": "critical"}},
        "required": ["criticality"]
      },
      "then": {"properties": {"required_covers": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"provider": {"const": "kani"}}, "required": ["provider"]},
      "then": {"properties": {"family": {"const": "bounded_model_check"}}}
    }
  ]
}
