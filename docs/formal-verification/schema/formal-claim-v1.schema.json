{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effortlessmetrics.dev/ripr/design/formal-claim-v1.schema.json",
  "title": "RIPR formal claim v1 design contract",
  "description": "Design contract only until the repository validator and runtime registry are implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "claim_generation",
    "family",
    "provider",
    "criticality",
    "phase",
    "proposition",
    "non_claims",
    "owners",
    "source_closure",
    "domain",
    "assumptions",
    "trust_dependencies",
    "observable",
    "bounds",
    "subjects",
    "required_covers",
    "negative_controls",
    "result_satisfaction",
    "currentness_inputs",
    "transition_policy",
    "owner_spec",
    "owner_issue"
  ],
  "properties": {
    "schema": {"const": "ripr.formal-claim.v1"},
    "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "claim_generation": {"type": "integer", "minimum": 1},
    "family": {
      "enum": [
        "bounded_model_check",
        "deductive_proof",
        "state_machine_model",
        "concurrency_model",
        "undefined_behavior_execution",
        "property_test",
        "fuzz_campaign",
        "mutation_calibration",
        "manual_or_external"
      ]
    },
    "provider": {"type": "string", "minLength": 1},
    "criticality": {
      "enum": ["critical", "important", "advisory", "scheduled", "manual"]
    },
    "phase": {
      "enum": [
        "ordinary_pr_critical",
        "merge_ready",
        "scheduled",
        "release",
        "manual"
      ]
    },
    "proposition": {"type": "string", "minLength": 1},
    "non_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_closure": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "domain": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "trust_dependencies": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "observable": {"type": "string", "minLength": 1},
    "bounds": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "integer", "number", "boolean"]
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_covers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "result_satisfaction": {"type": "string", "minLength": 1},
    "currentness_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "transition_policy": {"type": "string", "minLength": 1},
    "owner_spec": {"type": "string", "minLength": 1},
    "owner_issue": {"type": "integer", "minimum": 1}
  }
}
