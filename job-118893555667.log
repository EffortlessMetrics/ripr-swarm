2026-10-20T21:34:18.3826809Z def fixture_file(file, fixture_root):
2026-10-20T21:34:18.3827247Z     require(isinstance(file, str) and file, "listing file is empty")
2026-10-20T21:34:18.3827809Z     require(".." not in re.split(r"[\\/]", file), "listing file traverses the fixture")
2026-10-20T21:34:18.3828297Z     path = Path(file)
2026-10-20T21:34:18.3829173Z     require(not re.match(r"^[A-Za-z]:", file) or path.is_absolute(), "listing file has an unbound drive")
2026-10-20T21:34:18.3830315Z     require(not path.anchor or path.is_absolute(), "listing file has an unbound root")
2026-10-20T21:34:18.3831179Z     root = Path(fixture_root).resolve()
2026-10-20T21:34:18.3831934Z     resolved = (path if path.is_absolute() else root / path).resolve()
2026-10-20T21:34:18.3832770Z     require(resolved.is_relative_to(root), "listing file is outside the frozen fixture")
2026-10-20T21:34:18.3833275Z     return resolved
2026-10-20T21:34:18.3833589Z 
2026-10-20T21:34:18.3833929Z def packet(raw, fixture_root, selected_file, expected_id=None):
2026-10-20T21:34:18.3834388Z     data = json.loads(raw)
2026-10-20T21:34:18.3834705Z     findings = data.get("findings")
2026-10-20T21:34:18.3835202Z     require(isinstance(findings, list) and findings, "listing has no findings")
2026-10-20T21:34:18.3835755Z     selected_file = fixture_file(str(selected_file), fixture_root)
2026-10-20T21:34:18.3836797Z     selected = [f for f in findings if f.get("language") == "rust" and f.get("probe", {}).get("family") == "predicate"
2026-10-20T21:34:18.3837416Z                 and f["probe"].get("line") == 2
2026-10-20T21:34:18.3837908Z                 and fixture_file(f["probe"].get("file", ""), fixture_root) == selected_file
2026-10-20T21:34:18.3838455Z                 and f["probe"].get("expression") == "amount >= threshold"]
2026-10-20T21:34:18.3839025Z     require(len(selected) == 1, "listing does not identify the frozen fixture predicate")
2026-10-20T21:34:18.3839536Z     finding = selected[0]
2026-10-20T21:34:18.3840050Z     require(finding.get("id") and finding["probe"].get("id") == finding["id"], "listing identities disagree")
2026-10-20T21:34:18.3840593Z     if expected_id is not None:
2026-10-20T21:34:18.3841066Z         require(finding["id"] == expected_id, "listing selected another actual ID")
2026-10-20T21:34:18.3841520Z     return finding["id"]
2026-10-20T21:34:18.3841803Z 
2026-10-20T21:34:18.3842096Z def recovery_command(fixture, diff, windows=None):
2026-10-20T21:34:18.3843468Z     # Frozen fixture paths contain spaces: shell_arg quotes them; Windows display uses slashes.
2026-10-20T21:34:18.3844068Z     windows = os.name == "nt" if windows is None else windows
2026-10-20T21:34:18.3844578Z     paths = [str(fixture), str(diff)]
2026-10-20T21:34:18.3844928Z     if windows:
2026-10-20T21:34:18.3845344Z         paths = [p.removeprefix("\\\\?\\").replace("\\", "/") for p in paths]
2026-10-20T21:34:18.3845880Z     return f"ripr check --root '{paths[0]}' --diff '{paths[1]}' --json"
2026-10-20T21:34:18.3846289Z 
2026-10-20T21:34:18.3846712Z def printed_recovery(stderr, fixture, diff, windows=None):
2026-10-20T21:34:18.3847290Z     matches = re.findall(chr(96) + r"(ripr check [^\x60]+)" + chr(96), stderr.decode())
2026-10-20T21:34:18.3847849Z     require(len(matches) == 1, "one printed recovery command required")
2026-10-20T21:34:18.3848272Z     command = matches[0]
2026-10-20T21:34:18.3848848Z     require(command == recovery_command(fixture, diff, windows), "printed command lost frozen root/diff/JSON scope")
2026-10-20T21:34:18.3849423Z     return command
