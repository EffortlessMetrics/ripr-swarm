2026-10-20T21:34:18.3794908Z         startup.stdin, startup.stdout, startup.stderr = handles
2026-10-20T21:34:18.3795492Z         line = c.create_unicode_buffer(subprocess.list2cmdline([str(a) for a in argv]))
2026-10-20T21:34:18.3796561Z         # Inherit the unchanged environment; assign while suspended before any child code runs.
2026-10-20T21:34:18.3797442Z         require(k.CreateProcessW(str(argv[0]), line, None, None, True, 0x08000004, None, str(cwd), c.byref(startup), c.byref(proc)), "CreateProcess failed")
2026-10-20T21:34:18.3798297Z         require(k.AssignProcessToJobObject(job, proc.process), "Job assignment failed")
2026-10-20T21:34:18.3798958Z         require(k.ResumeThread(proc.thread) != 0xffffffff, "ResumeThread failed")
2026-10-20T21:34:18.3799462Z         deadline = min(end, started + seconds)
2026-10-20T21:34:18.3800165Z         while True:
2026-10-20T21:34:18.3800529Z             waited = k.WaitForSingleObject(proc.process, 100)
2026-10-20T21:34:18.3801130Z             require(waited != 0xffffffff, "Process wait failed")
2026-10-20T21:34:18.3801607Z             if sum(p.stat().st_size for p in paths) > output_cap:
2026-10-20T21:34:18.3802017Z                 stop = "output_limit"
2026-10-20T21:34:18.3802370Z             elif time.monotonic() >= deadline:
2026-10-20T21:34:18.3802758Z                 stop = "deadline"
2026-10-20T21:34:18.3803072Z             if stop:
2026-10-20T21:34:18.3803483Z                 require(k.TerminateJobObject(job, 124), "Job termination failed")
2026-10-20T21:34:18.3804164Z                 require(k.WaitForSingleObject(proc.process, 5000) == 0, "Terminated process not reaped")
