2026-10-20T21:34:18.3786593Z     limits = Limits()
2026-10-20T21:34:18.3786914Z     limits.basic.flags = 0x2000 | 0x200 | 0x10
2026-10-20T21:34:18.3787295Z     limits.basic.affinity = 3
2026-10-20T21:34:18.3787609Z     if active:
2026-10-20T21:34:18.3787891Z         limits.basic.flags |= 0x8
2026-10-20T21:34:18.3788237Z         limits.basic.active_limit = active
2026-10-20T21:34:18.3788610Z     limits.job_memory = memory
2026-10-20T21:34:18.3788913Z     try:
2026-10-20T21:34:18.3789196Z         job = k.CreateJobObjectW(None, None)
2026-10-20T21:34:18.3789561Z         require(job, "CreateJobObject failed")
2026-10-20T21:34:18.3790158Z         require(k.SetInformationJobObject(job, 9, c.byref(limits), c.sizeof(limits)), "Job limits failed")
2026-10-20T21:34:18.3790747Z         sa = Security(c.sizeof(Security), None, True)
2026-10-20T21:34:18.3791312Z         for path, access, disposition in [(Path("NUL"), 0x80000000, 3)] + [(p, 0x40000000, 2) for p in paths]:
2026-10-20T21:34:18.3792034Z             handle = k.CreateFileW(str(path), access, 3, c.byref(sa), disposition, 0x80, None)
2026-10-20T21:34:18.3792657Z             require(handle not in (None, c.c_void_p(-1).value), "Output handle failed")
2026-10-20T21:34:18.3793131Z             handles.append(handle)
2026-10-20T21:34:18.3793517Z         startup = Startup()
