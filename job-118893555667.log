2026-10-20T21:34:18.3804985Z             if waited == 0:
2026-10-20T21:34:18.3805277Z                 break
2026-10-20T21:34:18.3805579Z         code = w.DWORD()
2026-10-20T21:34:18.3806065Z         require(k.GetExitCodeProcess(proc.process, c.byref(code)), "Exit status unavailable")
2026-10-20T21:34:18.3806830Z         require(k.QueryInformationJobObject(job, 9, c.byref(limits), c.sizeof(limits), None), "Job peak unavailable")
2026-10-20T21:34:18.3807601Z         row = {"label": label, "argv": [str(a) for a in argv], "cwd": str(cwd), "exit": code.value,
2026-10-20T21:34:18.3808217Z                "stop": stop, "elapsed_ms": round((time.monotonic() - started) * 1000, 2),
2026-10-20T21:34:18.3808862Z                "affinity_mask": 3, "job_memory_limit": memory, "peak_job_memory": limits.peak_job_memory}
2026-10-20T21:34:18.3809388Z         receipt["cases"].append(row)
2026-10-20T21:34:18.3809749Z     finally:
2026-10-20T21:34:18.3810016Z         cleanup_ok = True
2026-10-20T21:34:18.3810310Z         try:
2026-10-20T21:34:18.3810574Z             if proc.process:
2026-10-20T21:34:18.3811033Z                 # Owns a still-suspended process even if job assignment failed.
2026-10-20T21:34:18.3811520Z                 k.TerminateProcess(proc.process, 124)
2026-10-20T21:34:18.3811878Z             if job:
2026-10-20T21:34:18.3812189Z                 k.TerminateJobObject(job, 124)
2026-10-20T21:34:18.3812561Z             if proc.process:
2026-10-20T21:34:18.3812962Z                 cleanup_ok = k.WaitForSingleObject(proc.process, 5000) == 0
2026-10-20T21:34:18.3813379Z             if job:
2026-10-20T21:34:18.3813691Z                 accounting = Accounting()
2026-10-20T21:34:18.3814087Z                 reap_end = time.monotonic() + 5
2026-10-20T21:34:18.3814444Z                 while True:
2026-10-20T21:34:18.3815083Z                     require(k.QueryInformationJobObject(job, 1, c.byref(accounting), c.sizeof(accounting), None), "Job cleanup state unavailable")
2026-10-20T21:34:18.3816100Z                     if accounting.active == 0:
2026-10-20T21:34:18.3816512Z                         break
2026-10-20T21:34:18.3816856Z                     if time.monotonic() >= reap_end:
2026-10-20T21:34:18.3817230Z                         cleanup_ok = False
2026-10-20T21:34:18.3817586Z                         break
2026-10-20T21:34:18.3817900Z                     time.sleep(0.02)
2026-10-20T21:34:18.3818216Z         finally:
2026-10-20T21:34:18.3818489Z             if job:
2026-10-20T21:34:18.3818807Z                 k.CloseHandle(job)
2026-10-20T21:34:18.3819209Z             for handle in handles + [proc.thread, proc.process]:
2026-10-20T21:34:18.3819728Z                 if handle:
2026-10-20T21:34:18.3820058Z                     k.CloseHandle(handle)
2026-10-20T21:34:18.3820497Z         require(cleanup_ok, "owned process tree was not reaped")
2026-10-20T21:34:18.3821504Z     stdout, stderr = [p.read_bytes() for p in paths]
2026-10-20T21:34:18.3822187Z     row.update(stdout_sha256=hashlib.sha256(stdout).hexdigest(), stderr_sha256=hashlib.sha256(stderr).hexdigest())
2026-10-20T21:34:18.3822873Z     require(not stop, label + ": bounded process stopped")
2026-10-20T21:34:18.3823288Z     return code.value, stdout, stderr
