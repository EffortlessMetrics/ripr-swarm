2026-10-20T21:21:46.9366622Z             info = original(path, *args, **kwargs)
2026-10-20T21:21:46.9366921Z             if path == self.stock:
2026-10-20T21:21:46.9367186Z                 values = list(info)
2026-10-20T21:21:46.9367455Z                 values[2] = info.st_dev + 1
2026-10-20T21:21:46.9367845Z                 return os.stat_result(values)
2026-10-20T21:21:46.9368119Z             return info
2026-10-20T21:21:46.9368388Z         with (patch.object(Path, 'stat', topology),
2026-10-20T21:21:46.9368818Z               patch.object(os, 'rename', side_effect=AssertionError('must not rename'))):
2026-10-20T21:21:46.9369312Z             with self.assertRaisesRegex(RuntimeError, 'cross-volume'):
2026-10-20T21:21:46.9369665Z                 self.stage()
2026-10-20T21:21:46.9370033Z         self.assertFalse(self.ownership['staged'])
2026-10-20T21:21:46.9370361Z         self.assertTrue(self.binary.exists())
