2026-10-20T21:34:18.3758409Z         return {"state": "NOT_CREATED"}
2026-10-20T21:34:18.3758792Z     for raw in allocation["producer_aliases"]:
2026-10-20T21:34:18.3759167Z         path = Path(raw)
2026-10-20T21:34:18.3759488Z         if path.exists():
2026-10-20T21:34:18.3760032Z             require(not path.is_symlink() and (path.stat().st_dev, path.stat().st_ino) ==
2026-10-20T21:34:18.3760678Z                     (allocation["device"], allocation["file_id"]), "producer alias identity drift")
2026-10-20T21:34:18.3761180Z             path.unlink()
2026-10-20T21:34:18.3761724Z     require(all(not Path(p).exists() for p in allocation["producer_aliases"]), "producer aliases remain")
2026-10-20T21:34:18.3762275Z     return {"state": "REMOVED"}
2026-10-20T21:34:18.3762581Z 
2026-10-20T21:34:18.3762997Z def stage_single_allocation(binary, staged, target, expected_digest, out, ownership):
2026-10-20T21:34:18.3763843Z     require(not staged.exists() and not staged.is_symlink() and shutil.which("ripr") is None, "unexpected existing stock ripr occupant")
2026-10-20T21:34:18.3764530Z     allocation = payload_allocation(binary, target)
2026-10-20T21:34:18.3765086Z     require(binary.stat().st_dev == staged.parent.stat().st_dev, "cross-volume staging refused")
2026-10-20T21:34:18.3765737Z     require(digest(binary) == expected_digest, "producer digest drift")
2026-10-20T21:34:18.3766497Z     require(allocation["charged_bytes"] + sum(p.stat().st_size for p in out.glob("*") if p.is_file()) < 128 * 1024**2, "staging/evidence budget exceeded")
2026-10-20T21:34:18.3767303Z     # Windows rename refuses an occupied destination. EXDEV/any failure is terminal;
2026-10-20T21:34:18.3767902Z     # never use shutil.move, which silently copies across volumes.
2026-10-20T21:34:18.3768357Z     ownership["allocation"] = allocation
2026-10-20T21:34:18.3768706Z     os.rename(binary, staged)
2026-10-20T21:34:18.3769028Z     ownership["staged"] = True
2026-10-20T21:34:18.3769692Z     require((staged.stat().st_dev, staged.stat().st_ino) == (allocation["device"], allocation["file_id"]), "rename changed allocation identity")
2026-10-20T21:34:18.3770462Z     # Retire only verified selected aliases. Dependencies and unrelated test
2026-10-20T21:34:18.3770985Z     # harnesses remain available to the cache post-action.
2026-10-20T21:34:18.3771381Z     remove_aliases(ownership)
2026-10-20T21:34:18.3771951Z     require(staged.stat().st_nlink == 1 and digest(staged) == expected_digest, "staged identity/digest drift")
2026-10-20T21:34:18.3772515Z     return allocation
2026-10-20T21:34:18.3772795Z 
2026-10-20T21:34:18.3773154Z def finalize_evidence(receipt, out, fixture, payload_charge):
2026-10-20T21:34:18.3773588Z     receipt["python"] = sys.version
2026-10-20T21:34:18.3773959Z     receipt["total_deadline_seconds"] = 720
2026-10-20T21:34:18.3774461Z     receipt["evidence_bytes"] = sum(p.stat().st_size for p in out.glob("*") if p.is_file())
2026-10-20T21:34:18.3775064Z     receipt["charged_binary_and_staging_bytes"] = payload_charge
2026-10-20T21:34:18.3775975Z     base_bytes = receipt["evidence_bytes"] + payload_charge + 16
2026-10-20T21:34:18.3776444Z     if fixture is not None and fixture.exists():
2026-10-20T21:34:18.3776945Z         base_bytes += sum(p.stat().st_size for p in fixture.rglob("*") if p.is_file())
2026-10-20T21:34:18.3777604Z     receipt["final_charged_bytes"] = 0
2026-10-20T21:34:18.3777939Z     while True:
2026-10-20T21:34:18.3778342Z         # Charge both the pretty receipt and its compact copy in the wrapper log.
2026-10-20T21:34:18.3779385Z         retained = base_bytes + len(json.dumps(receipt, indent=2).encode()) + len(json.dumps(receipt).encode()) + 2
2026-10-20T21:34:18.3780307Z         if retained > 128 * 1024**2 and receipt.get("error_type") != "EvidenceBudget":
2026-10-20T21:34:18.3781285Z             record_failure(receipt, "EvidenceBudget", "final evidence/staging budget exceeded")
2026-10-20T21:34:18.3782176Z             continue
2026-10-20T21:34:18.3782753Z         if receipt["final_charged_bytes"] == retained:
2026-10-20T21:34:18.3783136Z             return receipt
2026-10-20T21:34:18.3783482Z         receipt["final_charged_bytes"] = retained
