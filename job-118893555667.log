2026-10-20T21:21:46.9388775Z     def test_final_serialized_charge_is_exact_and_has_boundary(self):
2026-10-20T21:21:46.9389135Z         payload = 65536
2026-10-20T21:21:46.9389431Z         receipt = self.finalize({'state': 'PASS'}, payload)
2026-10-20T21:21:46.9389987Z         charge = payload + 16 + len(json.dumps(receipt, indent=2).encode()) + len(json.dumps(receipt).encode()) + 2
2026-10-20T21:21:46.9390552Z         self.assertEqual(receipt['final_charged_bytes'], charge)
2026-10-20T21:21:46.9391028Z         # A charge at the ceiling is allowed by finalization, one more byte refuses.
2026-10-20T21:21:46.9391417Z         target = 128 * 1024**2
2026-10-20T21:21:46.9391656Z         for _ in range(3):
2026-10-20T21:21:46.9391951Z             receipt = self.finalize({'state': 'PASS'}, payload)
2026-10-20T21:21:46.9392338Z             payload += target - receipt['final_charged_bytes']
2026-10-20T21:21:46.9392714Z         receipt = self.finalize({'state': 'PASS'}, payload)
2026-10-20T21:21:46.9393116Z         self.assertEqual(receipt['final_charged_bytes'], target)
2026-10-20T21:21:46.9393515Z         self.assertEqual(receipt['state'], 'PASS')
2026-10-20T21:21:46.9394018Z         self.assertEqual(self.finalize({'state': 'PASS'}, payload + 1)['error_type'], 'EvidenceBudget')
2026-10-20T21:21:46.9394460Z 
