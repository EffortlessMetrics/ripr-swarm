2026-10-20T21:34:18.3784281Z def run(label, argv, cwd, seconds=30, memory=512 * 1024**2, output_cap=2 * 1024**2, active=2):
2026-10-20T21:34:18.3784892Z     require(time.monotonic() < end, "consumer total deadline exceeded")
2026-10-20T21:34:18.3785407Z     paths = [out / (label + ".stdout"), out / (label + ".stderr")]
2026-10-20T21:34:18.3785875Z     handles, job, proc = [], None, Process()
