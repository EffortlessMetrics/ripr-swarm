+/// an unparseable scope never claims a write it cannot verify.
+fn scope_contains_test_fn(scope: &StubScope<'_>, rendered: &str, name: &str) -> bool {
+    let Some(parse) = parse_clean_source_file(scope.parse_unit) else {
+        return false;
+    };
