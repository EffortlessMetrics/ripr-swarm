+#[derive(Debug, PartialEq, Eq)]
+struct FileSnapshot {
+    bytes: Vec<u8>,
+    modified: std::time::SystemTime,
+    permissions: std::fs::Permissions,
+    #[cfg(unix)]
+    identity: (u64, u64, i64, i64),
