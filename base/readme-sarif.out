          "rules": [
            {
              "fullDescription": {
                "text": "Static analysis found a complete path from the changed code to a test oracle strong enough to observe the changed behavior."
              },
              "help": {
                "text": "This is static evidence, not a runtime verdict: ripr did not execute any test. Next step: run the linked related test and confirm it observes the changed sink."
              },
              "helpUri": "https://github.com/EffortlessMetrics/ripr-swarm/blob/main/docs/STATIC_EXPOSURE_MODEL.md#exposure-classes",
              "id": "ripr.finding.exposed",
              "name": "ripr exposed",
              "shortDescription": {
                "text": "Static exposure finding classified as exposed"
              }
            },
            {
              "fullDescription": {
                "text": "A static path from the change to a related test exists, but the infection or the oracle's discrimination looks weak, so the test could pass even when the behavior is wrong."
              },
              "help": {
                "text": "Static evidence only; no test was executed. Next step: strengthen the nearest assertion so it observes the changed sink directly, then re-run ripr check."
              },
              "helpUri": "https://github.com/EffortlessMetrics/ripr-swarm/blob/main/docs/STATIC_EXPOSURE_MODEL.md#exposure-classes",
              "id": "ripr.finding.weakly_exposed",
              "name": "ripr weakly_exposed",
              "shortDescription": {
                "text": "Static exposure finding classified as weakly_exposed"
              }
            },
            {
              "fullDescription": {
                "text": "Related tests appear to reach the changed code, but no meaningful oracle was found that would notice a wrong result."
              },
              "help": {
                "text": "Static evidence only; no test was executed. Next step: add or sharpen an assertion that discriminates the changed behavior."
              },
              "helpUri": "https://github.com/EffortlessMetrics/ripr-swarm/blob/main/docs/STATIC_EXPOSURE_MODEL.md#exposure-classes",
              "id": "ripr.finding.reachable_unrevealed",
              "name": "ripr reachable_unrevealed",
              "shortDescription": {
                "text": "Static exposure finding classified as reachable_unrevealed"
              }
            },
            {
              "fullDescription": {
                "text": "No static test path to the changed owner was found; static analysis could not trace any related test to this behavior."
              },
              "help": {
                "text": "This is a static reachability statement, not a runtime coverage measurement. Next step: add a focused test that exercises the changed behavior."
              },
              "helpUri": "https://github.com/EffortlessMetrics/ripr-swarm/blob/main/docs/STATIC_EXPOSURE_MODEL.md#exposure-classes",
              "id": "ripr.finding.no_static_path",
