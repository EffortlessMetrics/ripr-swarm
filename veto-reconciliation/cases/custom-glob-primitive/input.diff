--- /dev/null
+++ b/src/proof.rs
@@ -0,0 +1,17 @@
+use crate::foreign::*;
+struct Lease { elapsed: Option<std::primitive::u64> }
+fn charge(lease: &Lease) -> u64 {
+    match lease.elapsed {
+        Some(ms) => u64(ms),
+        None => u64(600),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn observes() {
+        let lease = Lease { elapsed: None };
+        assert_eq!(charge(&lease), 600);
+    }
+}
