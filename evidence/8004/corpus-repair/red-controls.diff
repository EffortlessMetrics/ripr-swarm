+    #[test]
+    fn inherent_receiver_corpus_boundary_and_live_scope() {
+        for (body, method, ty, expected) in [
+            ("fn t() { assert_eq!(ByteSize::gb(43).as_kib(), 1.0); }", "as_kib", "ByteSize", false),
+            ("fn t() { assert_eq!(ByteSize::kib(9).as_mb(), 1.0); }", "as_mb", "ByteSize", false),
+            ("fn t() { assert_eq!(ByteSize::new(43).as_kib(), 1.0); }", "as_kib", "ByteSize", true),
+            ("fn t() { let size: ByteSize = make(); assert_eq!(size.as_kib(), 1.0); }", "as_kib", "ByteSize", true),
+            ("fn t() { assert_eq!(Other::new(43).as_kib(), 1.0); }", "as_kib", "ByteSize", false),
+            ("fn t(account: Account) { assert_eq!(account.monthly_fee(), 5); }", "monthly_fee", "Account", false),
+            ("fn t() { let account: Account = make(); assert_eq!(account.monthly_fee(), 5); }", "monthly_fee", "Account", true),
+            ("fn t() { let account: Other = make(); assert_eq!(account.monthly_fee(), 5); }", "monthly_fee", "Account", false),
+            ("fn t() { for original in [\"x\"] { assert_eq!(UpperCase.apply_to_field(original), \"X\"); } }", "apply_to_field", "RenameRule", false),
+            ("fn t() { assert_eq!(LowerCase.apply_to_variant(\"X\"), \"x\"); }", "apply_to_variant", "RenameRule", false),
+            ("fn t() { assert_eq!(RenameRule::UpperCase.apply_to_field(\"x\"), \"X\"); }", "apply_to_field", "RenameRule", true),
+            ("fn t() { let value = JsonValue::Null; { let value = Foreign::new(); let _ = value; } assert_eq!(value.as_object(), None); }", "as_object", "JsonValue", true),
+            ("fn t() { let value = Foreign::new(); { let value = JsonValue::Null; let _ = value; } assert_eq!(value.as_object(), None); }", "as_object", "JsonValue", false),
+        ] {
+            let summary = test("src/lib.rs", "t", body);
+            assert_eq!(inherent_receiver_call_resolves(&summary, method, ty), expected, "{body}");
+        }
+    }
