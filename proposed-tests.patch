+#[test]
+fn no_subject_disclosure_preserves_existing_warning_and_failure() -> Result<(), String> {
+    let outcome = AnalysisOutcome::new(
+        AnalysisOutcomeKind::NoScope,
+        Default::default(),
+        AnalysisOutcomeCounts::default(),
+        Vec::new(),
+    )?;
+    for (status, color) in [(BadgeStatus::Warn, "orange"), (BadgeStatus::Fail, "red")] {
+        let (actual_status, actual_color, message, disclosed) =
+            super::summaries::apply_analysis_outcome_disclosure(
+                Some(&outcome),
+                status,
+                color,
+                "existing result".to_string(),
+            );
+        assert_eq!(actual_status, status);
+        assert_eq!(actual_color, color);
+        assert_eq!(message, "no analysis subject: no_scope");
+        let disclosed = disclosed.ok_or("typed outcome must remain present")?;
+        assert_eq!(disclosed.kind, AnalysisOutcomeKind::NoScope);
+        assert!(disclosed.kind.is_complete());
+    }
     Ok(())
 }
 
