+//! #8247: literal, independently executed controls for imported-owner identity.
+
+use super::classify::classify_change_with_source;
+use super::owners_tests::{extract_owners, extract_tests};
+use crate::domain::ExposureClass;
+use serde::Deserialize;
+use std::collections::BTreeSet;
+use std::path::Path;
+
+#[derive(Deserialize)]
+struct Corpus {
+    source_old: String,
+    source_new: String,
+    cases: Vec<Case>,
+}
+
+#[derive(Deserialize)]
+struct Case {
+    id: String,
+    test: String,
+    expected_class: String,
+}
+
+fn corpus() -> Result<Corpus, String> {
+    serde_json::from_str(include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/../../fixtures/python_shadowed_owner/corpus.json"
+    )))
+    .map_err(|error| format!("read literal #8247 corpus: {error}"))
+}
+
+fn classify_test(test_source: &str) -> Result<ExposureClass, String> {
+    let corpus = corpus()?;
+    classify_sources(test_source, &corpus.source_old, &corpus.source_new)
+}
+
+fn classify_sources(
+    test_source: &str,
+    source_old: &str,
+    source_new: &str,
+) -> Result<ExposureClass, String> {
+    let file = Path::new("src/shop.py");
+    let owners = extract_owners(file, source_new);
+    let tests = extract_tests(Path::new("tests/test_shop.py"), test_source);
+    assert_eq!(
+        owners
+            .iter()
+            .filter(|owner| owner.qualified_name == "fee")
+            .count(),
+        1
+    );
+    assert!(!tests.is_empty(), "the control must parse a test");
+    assert!(
+        tests.iter().any(|test| !test.assertions.is_empty()),
+        "the control must contain an oracle"
+    );
+    let new_line = source_new.lines().nth(3).ok_or("missing changed return")?;
+    let old_line = source_old.lines().nth(3).ok_or("missing prior return")?;
+    let finding = classify_change_with_source(
+        file,
+        4,
+        new_line,
+        Some(old_line),
+        &owners,
+        &tests,
+        Some(source_new),
+    )
+    .ok_or("changed return must produce a finding")?;
+    assert_eq!(finding.probe.location.line, 4);
+    assert!(
+        !finding.related_tests.is_empty(),
+        "retain the bounded syntactic relation"
+    );
+    Ok(finding.class)
+}
+
+#[test]
+fn owner_import_identity_preserves_the_eleven_independent_literal_cases() -> Result<(), String> {
+    let corpus = corpus()?;
+    let ids: BTreeSet<&str> = corpus.cases.iter().map(|case| case.id.as_str()).collect();
+    assert_eq!(corpus.cases.len(), 11);
+    assert_eq!(
+        ids,
+        BTreeSet::from([
+            "direct_literal",
+            "local_def",
+            "local_lambda",
+            "mock_payload",
+            "alias_mock_payload",
+            "exception_only",
+            "unrelated_local_def",
+            "bare_shadow_with_other_alias",
+            "real_alias",
+            "local_import",
+            "nested_helper_local_shadow",
+        ])
+    );
+    let mut mismatches = Vec::new();
+    for case in corpus.cases {
+        let actual = classify_test(&case.test)?;
+        if actual.as_str() != case.expected_class {
+            mismatches.push(format!(
+                "{}: expected {}, actual {}",
+                case.id,
+                case.expected_class,
+                actual.as_str()
+            ));
+        }
+    }
+    assert_eq!(mismatches, Vec::<String>::new());
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_does_not_borrow_an_alias_from_another_test() -> Result<(), String> {
+    let test = "from src.shop import fee\nfrom unittest.mock import Mock\n\ndef test_donor():\n    from src.shop import fee as price\n    price(10)\n\ndef test_fee():\n    fee(10)\n    price = Mock(return_value=30)\n    assert price(10) == 30\n";
+    assert_eq!(classify_test(test)?, ExposureClass::WeaklyExposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_does_not_borrow_a_same_named_test_row() -> Result<(), String> {
+    let test = "from src.shop import fee\n\nclass TestDonor:\n    def test_fee(self):\n        fee(10)\n\nclass TestShadow:\n    def test_fee(self):\n        def fee(amount):\n            return 30\n        assert fee(10) == 30\n";
+    assert_eq!(classify_test(test)?, ExposureClass::WeaklyExposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_rejects_the_same_alias_on_an_unrelated_receiver() -> Result<(), String> {
+    for import in [
+        "from src.shop import fee",
+        "from src.shop import fee as price",
+    ] {
+        let callee = if import.ends_with("price") {
+            "price"
+        } else {
+            "fee"
+        };
+        let test = format!(
+            "{import}\n\nclass Other:\n    def {callee}(self, amount):\n        return 30\n\ndef test_fee():\n    {callee}(10)\n    assert Other().{callee}(10) == 30\n"
+        );
+        assert_eq!(
+            classify_test(&test)?,
+            ExposureClass::WeaklyExposed,
+            "{callee}"
+        );
+    }
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_rejects_other_local_binding_shapes() -> Result<(), String> {
+    for binding in [
+        "fee, unused = (lambda amount: 30), None",
+        "fee: object = lambda amount: 30",
+        "fee = substitute = lambda amount: 30",
+        "from src.other import fee",
+        "if True:\n        from src.other import fee",
+        "assert (fee := lambda amount: 30)",
+        "note = f\"{(fee := lambda amount: 30)}\"",
+    ] {
+        let test = format!(
+            "from src.shop import fee\n\ndef test_fee():\n    {binding}\n    assert fee(10) == 30\n"
+        );
+        assert_eq!(
+            classify_test(&test)?,
+            ExposureClass::WeaklyExposed,
+            "{binding}"
+        );
+    }
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_preserves_a_body_import_restoring_a_module_shadow() -> Result<(), String> {
+    let test = "from src.shop import fee\nfee = lambda amount: 30\n\ndef test_fee():\n    from src.shop import fee\n    assert fee(10) == 30\n";
+    assert_eq!(classify_test(test)?, ExposureClass::Exposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_preserves_a_real_call_beside_an_unrelated_patch_helper()
+-> Result<(), String> {
+    let test = "from src.shop import fee\n\ndef patch():\n    return 30\n\ndef test_fee():\n    assert fee(10) == 30\n";
+    assert_eq!(classify_test(test)?, ExposureClass::Exposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_rejects_wrong_receiver_through_changed_literal_branch()
+-> Result<(), String> {
+    let test = "from src.shop import fee\n\nclass Other:\n    def fee(self, amount):\n        return 30\n\ndef test_fee():\n    fee(10)\n    assert Other().fee(10) == 30\n";
+    let old = "def fee(amount):\n    if amount < 0:\n        raise ValueError('negative')\n    return amount * 20\n";
+    let new = "def fee(amount):\n    if amount < 0:\n        raise ValueError('negative')\n    return amount * 30\n";
+    assert_eq!(
+        classify_sources(test, old, new)?,
+        ExposureClass::WeaklyExposed
+    );
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_preserves_grouped_real_calls() -> Result<(), String> {
+    for (import, assertion) in [
+        ("from src.shop import fee", "assert (fee(10)) == 30"),
+        (
+            "from src.shop import fee as price",
+            "assert ((price(10))) == 30",
+        ),
+    ] {
+        let test = format!("{import}\n\ndef test_fee():\n    {assertion}\n");
+        assert_eq!(classify_test(&test)?, ExposureClass::Exposed, "{assertion}");
+    }
+    let test = "from src.shop import fee\nimport unittest\n\nclass FeeTest(unittest.TestCase):\n    def test_fee(self):\n        self.assertEqual((fee(10)), 30)\n";
+    assert_eq!(classify_test(test)?, ExposureClass::Exposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_grouping_does_not_erase_a_wrapper_call() -> Result<(), String> {
+    let test = "from src.shop import fee\n\ndef fixed(value):\n    return 30\n\ndef test_fee():\n    assert fixed((fee(10))) == 30\n";
+    assert_eq!(classify_test(test)?, ExposureClass::WeaklyExposed);
+    Ok(())
+}
+
+#[test]
+fn owner_import_identity_walrus_names_stay_in_their_executable_scope() -> Result<(), String> {
+    for context in [
+        "def helper():\n    (fee := lambda amount: 30)\n",
+        "def test_other():\n    (fee := lambda amount: 30)\n    assert fee(10) == 30\n",
+    ] {
+        let test = format!(
+            "from src.shop import fee\n\n{context}\ndef test_fee():\n    assert fee(10) == 30\n"
+        );
+        assert_eq!(classify_test(&test)?, ExposureClass::Exposed, "{context}");
+    }
+    for statement in [
+        "def helper():\n        (fee := lambda amount: 30)",
+        "# fee := substitute",
+        "note = 'fee := substitute'",
+        "assert (unrelated := 30) == 30",
+    ] {
+        let test = format!(
+            "from src.shop import fee\n\ndef test_fee():\n    {statement}\n    assert fee(10) == 30\n"
+        );
+        assert_eq!(classify_test(&test)?, ExposureClass::Exposed, "{statement}");
+    }
+    for context in [
+        "(fee := lambda amount: 30)",
+        "note = f\"{(fee := lambda amount: 30)}\"",
+        "def helper(value=(fee := lambda amount: 30)):\n    return value",
+    ] {
+        let test = format!(
+            "from src.shop import fee\n\n{context}\n\ndef test_fee():\n    assert fee(10) == 30\n"
+        );
+        assert_eq!(
+            classify_test(&test)?,
+            ExposureClass::WeaklyExposed,
+            "{context}"
+        );
+    }
+    Ok(())
+}
