-fn has_active_reference(text: &str, target: &str) -> bool {
-    let lines = text.lines().collect::<Vec<_>>();
-    lines
-        .iter()
-        .enumerate()
-        .any(|(index, line)| line.contains(target) && !negative_context(&lines, index))
-}
