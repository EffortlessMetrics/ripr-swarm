{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/readiness-rehearsal-plan.schema.json",
  "title": "No-publish rehearsal plan receipt 1.1",
  "description": "Plan-only extension of RehearsalReceipt 1.0. No execution or readiness is established. Legacy 1.0 receipts remain governed by the existing shared Rust contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_sha",
    "tree_clean",
    "identity",
    "plan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "kind": {
      "const": "readiness_no_publish_rehearsal_receipt"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "tree_clean": {
      "const": true
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo_lock_digest",
        "rust_toolchain_digest",
        "crate_version"
      ],
      "properties": {
        "cargo_lock_digest": {
          "type": "string",
          "minLength": 1
        },
        "rust_toolchain_digest": {
          "type": "string",
          "minLength": 1
        },
        "crate_version": {
          "type": "string",
          "minLength": 1
        },
        "package_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "extension_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_os",
        "host_arch",
        "source_tree",
        "profile",
        "reads",
        "tools",
        "prohibited_operations",
        "writes",
        "cache_roots",
        "tags_created",
        "versions_changed",
        "candidate_frozen",
        "release_cut",
        "release_authority",
        "signing_performed",
        "credentials_accessed",
        "deployments_performed"
      ],
      "properties": {
        "host_os": {
          "type": "string",
          "minLength": 1
        },
        "host_arch": {
          "type": "string",
          "minLength": 1
        },
        "source_tree": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$",
          "minLength": 40,
          "maxLength": 40
        },
        "profile": {
          "const": "plan_only"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prohibited_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "writes": {
          "type": "array",
          "maxItems": 0
        },
        "cache_roots": {
          "type": "array",
          "maxItems": 0
        },
        "tags_created": {
          "type": "array",
          "maxItems": 0
        },
        "versions_changed": {
          "const": false
        },
        "candidate_frozen": {
          "const": false
        },
        "release_cut": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "signing_performed": {
          "const": false
        },
        "credentials_accessed": {
          "const": false
        },
        "deployments_performed": {
          "const": false
        }
      }
    },
    "crate_package": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "installed_binary": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "vsix": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "dependency_policy": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sbom": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance_plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "not_run"
            },
            "sha256": {
              "type": "null"
            },
            "limitation": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "server_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "not_run"
          },
          "sha256": {
            "type": "null"
          },
          "limitation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "install_smokes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "not_run"
          },
          "sha256": {
            "type": "null"
          },
          "limitation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "published_channels": {
      "type": "array",
      "maxItems": 0
    }
  }
}
