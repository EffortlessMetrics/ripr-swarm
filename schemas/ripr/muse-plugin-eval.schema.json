{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effortlessmetrics.dev/ripr/muse-plugin-eval.schema.json",
  "title": "RIPR Muse Plugin Evaluation Record V1",
  "description": "Machine-readable muse-plugin-eval-v1 record for one Muse RIPR plugin scenario run. Static RIPR verdicts and executed-test verdicts are separate properties; a missing measurement is the string not_measured or unknown, never zero. Domain review owns judgment; this schema closes the wire shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "environment",
    "task",
    "mcp",
    "verdicts"
  ],
  "properties": {
    "schema_version": { "const": "muse-plugin-eval-v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "fixture_digest", "ripr_version", "plugin_version", "muse_version"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "fixture_digest": { "type": "string", "minLength": 1 },
        "ripr_commit": { "type": ["string", "null"] },
        "ripr_version": { "type": "string", "minLength": 1 },
        "plugin_version": { "type": "string", "minLength": 1 },
        "muse_version": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "git_head", "working_tree"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "runner_class": { "type": "string", "minLength": 1 },
        "git_head": { "type": "string", "minLength": 1 },
        "base": { "type": ["string", "null"] },
        "working_tree": { "enum": ["clean", "dirty", "unknown"] },
        "ripr_binary": { "enum": ["mcp_capable", "predates_mcp", "missing", "unknown"] }
      }
    },
    "model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "configuration": { "type": "string" },
        "trial_id": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_request", "expected_oracle"],
      "properties": {
        "initial_request": { "type": "string", "minLength": 1 },
        "expected_oracle": { "type": "string", "minLength": 1 }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools_discovered", "setup_outcome"],
      "properties": {
        "tools_discovered": { "type": "array", "items": { "type": "string" } },
        "setup_outcome": {
          "enum": ["ready", "approval_required", "server_unavailable", "no_scope", "base_required", "limited", "not_run"]
        },
        "calls": { "type": "array", "items": { "type": "string" } },
        "refusals": { "type": "array", "items": { "type": "string" } },
        "snapshot_ids": { "type": "array", "items": { "type": "string" } },
        "fresh_for_working_tree": { "type": ["boolean", "null"] }
      }
    },
    "repair": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "canonical_id": { "type": ["string", "null"] },
        "seam_id": { "type": ["string", "null"] },
        "attempt_id": { "type": ["string", "null"] },
        "edit_paths": { "type": "array", "items": { "type": "string" } },
        "before_class": { "type": ["string", "null"] },
        "after_class": { "type": ["string", "null"] }
      }
    },
    "execution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_status"],
            "properties": {
              "command": { "type": "string" },
              "exit_status": { "type": ["integer", "null"] },
              "role": { "enum": ["positive", "wrong_implementation_control", "restore", "other"] }
            }
          }
        }
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_verdict", "executed_verdict", "combined_claim"],
      "properties": {
        "static_verdict": { "type": "string", "minLength": 1 },
        "executed_verdict": { "type": "string", "minLength": 1 },
        "combined_claim": {
          "enum": ["completed_repair", "not_completed", "refused", "not_applicable"]
        },
        "unsupported_claims": { "type": "array", "items": { "type": "string" } },
        "unintended_edits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time": { "type": ["string", "number"], "description": "Seconds, or the string not_measured." },
        "time_to_first_useful_finding": { "type": ["string", "number"] },
        "model_calls": { "type": ["integer", "null"] },
        "tool_calls": { "type": ["integer", "null"] },
        "input_tokens": { "type": ["integer", "null"] },
        "output_tokens": { "type": ["integer", "null"] },
        "reported_cost": { "type": ["string", "number"] },
        "peak_memory": { "type": ["string", "number"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transcript_path": { "type": ["string", "null"] },
        "output_digests": { "type": "array", "items": { "type": "string" } },
        "evaluator_version": { "type": ["string", "null"] },
        "judgment": { "type": ["string", "null"] }
      }
    }
  }
}
