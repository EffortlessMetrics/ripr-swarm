+fn trace_quarantine_refresh(backend: &Backend, fixture: &QuarantineFixture, label: &str) {
+    let document = backend.document_state_for_test(&fixture.uri_a);
+    let saved_digest = document
+        .as_ref()
+        .and_then(|state| state.saved_digest.clone());
+    let analyzed_digest = document
+        .as_ref()
+        .and_then(|state| state.analyzed_saved_digest.clone());
+    let dedup_recorded = saved_digest
+        .as_ref()
+        .map(|digest| backend.saved_digest_is_recorded_for_test(&fixture.uri_a, digest));
+    eprintln!(
+        "RIPR_TEST_REFRESH_DIAGNOSTIC {}",
+        serde_json::json!({
+            "label": label,
+            "revision": backend.workspace_revision(),
+            "health": format!("{:?}", backend.analysis_health_for_test()),
+            "saved_digest": saved_digest,
+            "analyzed_digest": analyzed_digest,
+            "dedup_recorded": dedup_recorded,
+        })
+    );
+}
