+    #[test]
+    fn current_manifest_refuses_stale_shard_identity_before_replacement() -> Result<(), String> {
+        for stale_inner in [false, true] {
+            let scratch = integrity_scratch("composed-mixed-shard-generation")?;
+            let cache = RepoSeamFactCache::at_dir(scratch.0.clone());
+            let key = empty_state().cache_key();
+            assert_eq!(key.schema_version, "1.160");
+            let favorable = vec![synthesized_discarded_oracle_classified(); 2];
+            let fallback = vec![PathBuf::from("src/fallback.rs")];
+            cache.store_classified_seams_with_limit_and_fallback(
+                &key, &favorable, None, &fallback, 1,
+            )?;
+            assert_classified_cache_values(&cache, &key, &favorable)?;
+            let manifest_path = cache.sharded_manifest_path(&key);
+            let manifest_bytes = std::fs::read(&manifest_path).map_err(|err| err.to_string())?;
+            let manifest = codec::decode_sharded_manifest(&manifest_bytes)?;
+            manifest.validate_integrity()?;
+            assert!(manifest.matches_key(&key));
+            assert_eq!(manifest.sharded_cache_schema_version, "0.162");
+            let shard = manifest.shards.first().ok_or("missing seeded shard")?;
+            let shard_path = cache.sharded_entry_dir(&key).join(&shard.file);
+            let mut envelope =
+                codec::decode_shard(&std::fs::read(&shard_path).map_err(|err| err.to_string())?)?;
+            assert!(envelope.matches_key(&key));
+            if stale_inner {
+                envelope.sharded_cache_schema_version = "0.161".to_string();
+            } else {
+                envelope.schema_version = "1.159".to_string();
+            }
+            // Recompute integrity so refusal must exercise shard identity,
+            // independently of the current, still-valid manifest fence.
+            std::fs::write(&shard_path, codec::encode_shard(&envelope)?)
+                .map_err(|err| err.to_string())?;
+            let seeded =
+                codec::decode_shard(&std::fs::read(&shard_path).map_err(|err| err.to_string())?)?;
+            seeded.validate_integrity()?;
+            assert!(!seeded.matches_key(&key));
+            assert_eq!(
+                std::fs::read(&manifest_path).map_err(|err| err.to_string())?,
+                manifest_bytes,
+            );
+            match cache.load_classified_seams_with_fallback(&key) {
+                CacheLoad::CorruptIgnored { reason } => assert_eq!(
+                    reason,
+                    format!("sharded cache key mismatch in {}", shard.file),
+                ),
+                other => return Err(format!("expected shard-specific refusal, got {other:?}")),
+            }
+            let corrected = vec![sample_classified(); 2];
+            cache.store_classified_seams_with_limit_and_fallback(
+                &key, &corrected, None, &fallback, 1,
+            )?;
+            assert_classified_cache_values(&cache, &key, &corrected)?;
+            let CacheLoad::Hit((_, limit, loaded_fallback)) =
+                cache.load_classified_seams_with_fallback(&key)
+            else {
+                return Err("replacement must produce an actual warm hit".to_string());
+            };
+            assert!(limit.is_none());
+            assert_eq!(loaded_fallback, fallback);
+        }
+        Ok(())
+    }
