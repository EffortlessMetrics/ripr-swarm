+    #[test]
+    fn production_compact_generation_uses_full_workspace_key_and_separate_paths()
+    -> Result<(), String> {
+        for sharded in [false, true] {
+            let scratch = integrity_scratch("composed-production-compact-generation")?;
+            let expected_base = scratch.0.join("target/ripr/cache");
+            // The real constructor reads process configuration. Refuse before
+            // any cache write rather than mutating global environment or using
+            // a shared override as this test's disposable fixture.
+            if cache_base_dir(&scratch.0) != expected_base {
+                return Err(
+                    "production compact generation fixture requires RIPR_CACHE_DIR unset or empty"
+                        .to_string(),
+                );
+            }
+            let cache = RepoSeamFactCache::at_compact_classified(&scratch.0);
+            assert_eq!(COMPACT_CLASSIFIED_SEAM_CACHE_SCHEMA_VERSION, "0.162");
+            assert_eq!(
+                cache.dir,
+                expected_base.join("repo-compact-classified-seams/0.162")
+            );
+            assert_eq!(
+                cache.sharded_dir,
+                expected_base.join("repo-compact-classified-seams-sharded/0.162/0.162")
+            );
+            let key = WorkspaceState {
+                workspace_root: &scratch.0,
+                ..empty_state()
+            }
+            .cache_key();
+            assert_eq!(key.schema_version, "1.160");
+            assert_ne!(
+                key.schema_version,
+                COMPACT_CLASSIFIED_SEAM_CACHE_SCHEMA_VERSION
+            );
+            let previous_key = RepoSeamCacheKey {
+                schema_version: "1.159".to_string(),
+                ..key.clone()
+            };
+            let previous = RepoSeamFactCache::at_base(
+                &expected_base,
+                ClassifiedCacheFamily::CompactClassifiedSeams,
+                "0.161",
+            );
+            assert_ne!(previous.dir, cache.dir);
+            assert_ne!(previous.sharded_dir, cache.sharded_dir);
+            let favorable = vec![synthesized_discarded_oracle_classified(); 2];
+            let fallback = vec![PathBuf::from("src/compact-fallback.rs")];
+            let store_limit = if sharded { 1 } else { 10 };
+            previous.store_compact_classified_seams_with_limit_and_fallback(
+                &previous_key,
+                &favorable,
+                &fallback,
+                store_limit,
+            )?;
+            assert_classified_cache_values(&previous, &previous_key, &favorable)?;
+            assert!(matches!(
+                cache.load_classified_seams_with_fallback(&key),
+                CacheLoad::Miss
+            ));
+            // Challenge the outer envelope fence after relocating the old
+            // signed payload into this generation's actual production path.
+            let (old_path, current_path) = if sharded {
+                (
+                    previous.sharded_manifest_path(&previous_key),
+                    cache.sharded_manifest_path(&key),
+                )
+            } else {
+                (previous.entry_path(&previous_key), cache.entry_path(&key))
+            };
+            std::fs::create_dir_all(current_path.parent().ok_or("missing cache parent")?)
+                .map_err(|err| err.to_string())?;
+            let stale = std::fs::read(old_path).map_err(|err| err.to_string())?;
+            std::fs::write(current_path, stale).map_err(|err| err.to_string())?;
+            assert!(matches!(
+                cache.load_classified_seams_with_fallback(&key),
+                CacheLoad::Miss
+            ));
+            let corrected = vec![sample_classified(); 2];
+            cache.store_compact_classified_seams_with_limit_and_fallback(
+                &key,
+                &corrected,
+                &fallback,
+                store_limit,
+            )?;
+            assert_classified_cache_values(&cache, &key, &corrected)?;
+            let CacheLoad::Hit((_, limit, loaded_fallback)) =
+                cache.load_classified_seams_with_fallback(&key)
+            else {
+                return Err("current production compact payload must warm-hit".to_string());
+            };
+            assert!(limit.is_none());
+            assert_eq!(loaded_fallback, fallback);
+            if sharded {
+                assert!(cache.sharded_manifest_path(&key).is_file());
+                assert!(!cache.entry_path(&key).exists());
+            } else {
+                assert!(cache.entry_path(&key).is_file());
+                assert!(!cache.sharded_manifest_path(&key).exists());
+            }
+        }
+        Ok(())
+    }
