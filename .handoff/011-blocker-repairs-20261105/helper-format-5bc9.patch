+    let mut captures = BTreeSet::new();
+    while at < chars.len() {
+        match chars[at] {
+            '{' if chars.get(at + 1) == Some(&'{') => at += 2,
+            '}' if chars.get(at + 1) == Some(&'}') => at += 2,
