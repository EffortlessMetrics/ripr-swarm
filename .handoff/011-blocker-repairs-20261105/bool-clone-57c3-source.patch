+        {
+            return false;
+        }
+        let surface = ExpansionSurface::scan_with_workspace_globs(
+            index
+                .files()
+                .values()
+                .map(|facts| std::sync::Arc::clone(&facts.source)),
+            true,
+        );
+        surface.bounded_apart_from_drop && !surface.excluded_apart_from_drop.contains("bool")
+    })
+}
