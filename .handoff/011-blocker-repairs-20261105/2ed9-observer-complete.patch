+            scratch.0.join("Cargo.toml"),
+        )
+        .map_err(|e| e.to_string())?;
+        std::fs::write(scratch.0.join("src/lib.rs"), source.replace(original, body))
+            .map_err(|e| e.to_string())?;
+        let report = check_workspace(CheckInput {
