+        ("CARGO_TERM_COLOR", OsString::from("never")),
+        ("CARGO_PROFILE_TEST_STRIP", OsString::from(mode)),
+        ("RUSTC", tools.rustc.as_os_str().to_owned()),
+        ("RUSTC_WRAPPER", OsString::new()),
+        ("RUSTC_WORKSPACE_WRAPPER", OsString::new()),
+        ("RUSTFLAGS", OsString::new()),
