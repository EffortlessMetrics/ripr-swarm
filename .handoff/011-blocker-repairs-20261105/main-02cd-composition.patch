+            "CARGO_ENCODED_RUSTFLAGS",
+            OsString::from("-C\u{1f}instrument-coverage\u{1f}-C\u{1f}link-arg=-Wl,--build-id=sha1"),
+        ),
+    ];
+    let output = native_output(
+        root,
