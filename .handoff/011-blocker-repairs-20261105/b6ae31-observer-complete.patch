+        return false;
+    };
+    let list = |node: &SyntaxNode| {
+        node.ancestors()
+            .find(|ancestor| ast::StmtList::can_cast(ancestor.kind()))
+    };
+    call.syntax().text_range().start() >= binding.syntax().text_range().end()
+        && list(call.syntax()).is_some()
+        && list(call.syntax()) == list(binding.syntax())
