{
  "schema_version": "1",
  "kind": "ripr_rust_corpus_manifest",
  "corpus_version": "2026-10-04.1",
  "description": "Pinned real-world Rust repositories shared by ripr evaluation work (scoreboards, verdict checks, CPU/memory/size measurements, mutation spot-checks, first-run tests). Each entry pins one upstream commit and its first parent so every subject has both a whole-repo state and a real upstream diff.",
  "selection_rule": "For each repository, the pinned commit is a recent first-parent commit on the default branch (fetched 2026-10-04) whose diff against its first parent changes 1 to 12 non-test .rs files and 6 to 400 Rust lines, preferring behavior fixes over chores. base_sha is that commit's first parent, so `git diff base_sha sha` is the change a reviewer actually saw.",
  "limits": [
    "pins are exact commits; refreshing them is a new corpus_version, never an in-place edit",
    "probe counts are lexical file counts measured at the pin on 2026-10-04 and describe the subject, not ripr behavior",
    "fetching is opt-in network (--allow-network) and never runs on the default CI path",
    "the corpus is Rust-only; Python subjects stay in fixtures/python-eval-sweep/manifest.json",
    "no repository here is vendored or redistributed; checkouts live under target/"
  ],
  "tiers": {
    "fast": {
      "purpose": "Pull-request and quick local runs: small and medium repositories, each under ~25 MB checked out.",
      "selects": "repos with tier = fast"
    },
    "full": {
      "purpose": "Nightly and release measurement: every repository, including the large monorepos.",
      "selects": "every repo"
    }
  },
  "stress_categories": [
    {
      "id": "proc_macro",
      "description": "Product code is a proc-macro or derive; behavior is observable only through expansion.",
      "full_only": false
    },
    {
      "id": "compile_fail_ui_tests",
      "description": "trybuild-style UI tests whose oracle is compiler stderr.",
      "full_only": false
    },
    {
      "id": "build_rs",
      "description": "build.rs scripts that probe the compiler or generate code at build time.",
      "full_only": false
    },
    {
      "id": "no_std",
      "description": "#![no_std] or cfg_attr no_std crates.",
      "full_only": false
    },
    {
      "id": "embedded",
      "description": "Embedded targets where most tests cannot run on the host.",
      "full_only": false
    },
    {
      "id": "async_no_std",
      "description": "async executors and drivers without std.",
      "full_only": true
    },
    {
      "id": "generated_code",
      "description": "Large checked-in or build-time generated Rust.",
      "full_only": false
    },
    {
      "id": "large_library",
      "description": "Library over ~150k Rust lines.",
      "full_only": false
    },
    {
      "id": "workspace",
      "description": "Multi-crate Cargo workspace.",
      "full_only": false
    },
    {
      "id": "large_workspace",
      "description": "Workspace with 40 or more Cargo manifests.",
      "full_only": true
    },
    {
      "id": "large_monorepo",
      "description": "Repository-scale subject (over ~300k lines or over ~100 manifests); full tier only.",
      "full_only": true
    },
    {
      "id": "binary_crate",
      "description": "Primary product is a binary, not a library.",
      "full_only": false
    },
    {
      "id": "small_crate",
      "description": "Under ~10k lines; cheapest real-repo smoke subject.",
      "full_only": false
    },
    {
      "id": "custom_test_macro",
      "description": "Tests declared through a project-specific macro or attribute (rgtest!, #[cargo_test]).",
      "full_only": false
    },
    {
      "id": "custom_test_harness",
      "description": "Test targets with harness = false or a non-libtest runner.",
      "full_only": false
    },
    {
      "id": "test_macro_rstest",
      "description": "Tests written with rstest fixtures and cases.",
      "full_only": false
    },
    {
      "id": "test_macro_proptest",
      "description": "Tests written with proptest! strategies.",
      "full_only": false
    },
    {
      "id": "snapshot_tests",
      "description": "Oracles held in snapshots (insta, snapbox/trycmd, expect-test).",
      "full_only": false
    },
    {
      "id": "async_tokio",
      "description": "tokio-based async code with #[tokio::test].",
      "full_only": false
    },
    {
      "id": "loom_model_tests",
      "description": "Concurrency model tests behind cfg(loom).",
      "full_only": true
    },
    {
      "id": "ffi",
      "description": "extern \"C\" boundaries or bindgen bindings.",
      "full_only": false
    },
    {
      "id": "bundled_c",
      "description": "Vendored C sources compiled by build.rs.",
      "full_only": false
    },
    {
      "id": "wasm_target",
      "description": "wasm32 code with wasm-bindgen tests.",
      "full_only": true
    }
  ],
  "known_gaps": [
    "no application-style tokio service binary with a database layer (axum covers the library side)",
    "no repository that runs tests through cargo-nextest-only configuration",
    "no Windows-only or cfg(windows)-dominant crate",
    "no crate whose tests live exclusively in a separate tests crate of another repository"
  ],
