2026-10-20T22:48:51.6888511Z         nodes = next(n for n in self.tree.body if isinstance(n, ast.Try)).finalbody
2026-10-20T22:48:51.6888781Z         start = next(i for i, n in enumerate(nodes) if isinstance(n, ast.Assign)
2026-10-20T22:48:51.6889030Z                      and ast.unparse(n.targets[0]) == "receipt['python']")
