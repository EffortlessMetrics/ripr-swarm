2026-10-20T22:48:51.6884710Z                                                            self.ns['digest'](self.binary), self.out, self.ownership)
2026-10-20T22:48:51.6885019Z         # Pre-repair: execute the real admission and copy statements from Actions.
2026-10-20T22:48:51.6885296Z         body = next(n for n in self.tree.body if isinstance(n, ast.Try)).body
2026-10-20T22:48:51.6885559Z         start = next(i for i, n in enumerate(body) if isinstance(n, ast.Assign)
2026-10-20T22:48:51.6885855Z                      and any(isinstance(t, ast.Name) and t.id == 'staged' for t in n.targets))
2026-10-20T22:48:51.6886160Z         end = next(i for i in range(start, len(body)) if isinstance(body[i], ast.Assign)
2026-10-20T22:48:51.6886466Z                    and any(isinstance(t, ast.Name) and t.id == 'resolved' for t in body[i].targets))
2026-10-20T22:48:51.6886770Z         ns = dict(self.ns, binary=self.binary, stock_bin=self.stock, out=self.out)
2026-10-20T22:48:51.6887025Z         with patch.object(shutil, 'which', return_value=None):
2026-10-20T22:48:51.6887280Z             exec(compile(ast.Module(body[start:end], []), str(WORKFLOW), 'exec'), ns)
2026-10-20T22:48:51.6887545Z         return {'charged_bytes': 2 * self.binary.stat().st_size}
